                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              <span class="mt-1 block text-xs text-neutral-500">$2 по умолчанию</span>
            </label>
            <label class="block">
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.08em] text-neutral-500">Premium
