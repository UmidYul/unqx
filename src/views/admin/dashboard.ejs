        <script nonce="<%= cspNonce %>" id="admin-dashboard-query"
          type="application/json"><%- JSON.stringify(pageQuery) %></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/admin-layout.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/admin-dialogs.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/vendor/sortablejs/Sortable.min.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/vendor/qrcode/qrcode.min.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/vendor/chartjs/chart.umd.min.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/card-view.js') %>"></script>
        <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/admin-dashboard.js') %>"></script>
        <% if (adminSession?.role !=='manager' ) { %>
          <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/admin-features.js') %>"></script>
          <script nonce="<%= cspNonce %>" src="<%= withPageAssetVersion('/js/admin-settings.js') %>"></script>
          <% } %>
  </body>

  </html>
