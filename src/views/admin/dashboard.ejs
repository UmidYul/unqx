<% const pageTitle=typeof title==="string" && title ? title : "Дашборд" ; const pageActiveTab=typeof
  activeTab==="string" && activeTab ? activeTab : "analytics" ; const pagePublicBaseUrl=typeof publicBaseUrl==="string"
  && publicBaseUrl ? publicBaseUrl : "" ; const pageQuery=typeof query==="object" && query ? query : {}; const
  pageDashboardBase=typeof dashboardBasePath==="string" && dashboardBasePath ? dashboardBasePath : "/admin/dashboard" ;
  const pageAssetVersion=typeof assetVersion==="string" && assetVersion ? assetVersion : ""; const withPageAssetVersion=(src)=> {
  const value=String(src || ""); if (!value || !pageAssetVersion || !value.startsWith("/")) return value; return `${value}${value.includes("?") ? "&" : "?"}v=${encodeURIComponent(pageAssetVersion)}`; };
  const TAB_META = {
    analytics:       { title: "Аналитика",             desc: "Ключевые метрики, динамика продаж и показатели активности платформы.",      action: { label: "Управлять slug", href: pageDashboardBase + "?tab=slugs" } },
    orders:          { title: "Заявки",                desc: "Входящие заявки на slug, статусы платежей и история обработки.",             action: null },
    purchases:       { title: "Покупки",               desc: "Все успешные покупки slug-идентификаторов и подписок.",                       action: null },
    "payment-cards": { title: "Платёжные карты",       desc: "Привязанные карты пользователей и история транзакций.",                      action: null },
    cards:           { title: "Визитки",               desc: "Управление профилями и цифровыми карточками пользователей.",                 action: null },
    users:           { title: "Пользователи",          desc: "База аккаунтов, поиск, управление профилями и смена паролей.",               action: null },
    accounts:        { title: "Аккаунты",              desc: "Все зарегистрированные аккаунты. Новые — сверху.",                           action: null },
    slugs:           { title: "Slug-идентификаторы",   desc: "Редактирование, переименование и мониторинг slug.",                          action: null },
    score:           { title: "UNQ Score",             desc: "Рейтинги пользователей и система начисления баллов.",                        action: null },
    "flash-sales":   { title: "Flash Sale",            desc: "Акции с ограниченным временем, скидки и настройки распродаж.",               action: null },
    drops:           { title: "Дропы",                 desc: "Эксклюзивные выпуски slug и управление доступом к ним.",                     action: null },
    leaderboard:     { title: "Лидерборд",             desc: "Рейтинг пользователей и соревновательная механика платформы.",               action: null },
    referrals:       { title: "Рефералы",              desc: "Отслеживание реферальных ссылок и партнёрских вознаграждений.",              action: null },
    promocodes:      { title: "Промокоды",             desc: "Создание и управление акционными кодами для пользователей.",                 action: null },
    verification:    { title: "Верификация",           desc: "Проверка и подтверждение личности пользователей.",                           action: null },
    badges:          { title: "Бейджи",                desc: "Управление наградами и значками пользователей.",                             action: null },
    pets:            { title: "Животные",              desc: "Питомцы пользователей и заявки на добавление новых.",                        action: null },
    reports:         { title: "Репорты",               desc: "Жалобы, модерация контента и действия по нарушениям.",                      action: null },
    settings:        { title: "Настройки платформы",   desc: "Конфигурация системы, цены и параметры сервиса.",                            action: null },
    testimonials:    { title: "Отзывы",                desc: "Модерация и управление отзывами пользователей.",                             action: null },
    managers:        { title: "Менеджеры",             desc: "Управление доступом и правами менеджеров платформы.",                        action: null },
    activity:        { title: "Активность",             desc: "Лог действий пользователей: входы, обновления визиток, смены паролей.",      action: null },
    logs:            { title: "Логи системы",          desc: "Журнал событий, ошибок и действий администраторов.",                         action: null },
  };
  const _tabMeta = TAB_META[pageActiveTab] || { title: "Управление платформой", desc: "Мониторинг заявок, пользователей и маркетинговых инструментов.", action: null };
  const pageHeroTitle = adminSession?.role === "manager" ? "Рабочий стол менеджера" : _tabMeta.title;
  const pageHeroDesc  = adminSession?.role === "manager" ? "Полный user flow: создание аккаунтов, продажи и верификация." : _tabMeta.desc;
  const pageHeroAction = adminSession?.role === "manager" ? null : _tabMeta.action;
  %>
  <!doctype html>
  <html lang="ru">

  <head>
    <%- include('../partials/head', { title: pageTitle, styles: ['/css/admin.css'] }) %>
  </head>

  <body class="antialiased" data-admin-layout="1" data-page="admin-dashboard"
    data-public-base-url="<%= pagePublicBaseUrl %>" data-active-tab="<%= pageActiveTab %>"
    data-admin-role="<%= adminSession?.role || 'admin' %>" data-bwignore="true" data-lpignore="true"
    data-1p-ignore="true">
    <%- include('../partials/admin-layout-start', { activeTab: pageActiveTab, dashboardBasePath: pageDashboardBase }) %>
      <div class="mx-auto w-full max-w-6xl space-y-5">
        <div id="admin-maintenance-banner"
          class="hidden rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p id="admin-maintenance-text" class="font-semibold">Режим обслуживания включён — сайт недоступен для
              пользователей</p>
            <button id="admin-maintenance-disable" type="button"
              class="interactive-btn min-h-11 rounded-xl border border-rose-300 px-3 py-1.5 text-xs font-semibold text-rose-800 hover:bg-rose-100">Отключить</button>
          </div>
        </div>
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-neutral-200 pb-4">
          <div>
            <h1 class="text-2xl font-black"><%= pageHeroTitle %></h1>
            <p class="mt-1 text-sm text-neutral-600"><%= pageHeroDesc %></p>
          </div>
          <% if (pageHeroAction) { %>
            <a href="<%= pageHeroAction.href %>"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-neutral-900 px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-neutral-700 sm:w-auto">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
              <span><%= pageHeroAction.label %></span>
            </a>
          <% } %>
        </div>

        <section id="tab-analytics" class="<%= pageActiveTab === 'analytics' ? '' : 'hidden' %> space-y-4">
          <header class="rounded-2xl border border-neutral-200 bg-white p-4">
            <h2 class="text-base font-bold text-neutral-900">Аналитика</h2>
            <p class="mt-1 text-sm text-neutral-600">Ключевые метрики и динамика продаж платформы.</p>
          </header>
          <section class="rounded-2xl border border-neutral-200 bg-white p-4">
            <h3 class="text-sm font-semibold text-neutral-900">Фильтры аналитики</h3>
            <form id="analytics-filters" class="mt-3 grid gap-3 md:grid-cols-[220px_220px_220px_auto_auto]">
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Период с</span>
                <input type="date" name="dateFrom"
                  class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">По</span>
                <input type="date" name="dateTo"
                  class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Группировка</span>
                <select name="groupBy" class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="day">По дням</option>
                  <option value="week">По неделям</option>
                  <option value="month">По месяцам</option>
                </select>
              </label>
              <button type="submit"
                class="self-end inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Применить</button>
              <button type="reset"
                class="self-end inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Сбросить</button>
            </form>
          </section>
          <section class="space-y-2">
            <h3 class="text-sm font-semibold text-neutral-900">Ключевые метрики</h3>
            <div id="analytics-kpis" class="grid gap-3 md:grid-cols-2 xl:grid-cols-3"></div>
          </section>
          <section class="space-y-2">
            <h3 class="text-sm font-semibold text-neutral-900">Графики</h3>
            <div class="grid gap-4 lg:grid-cols-2">
              <article class="rounded-2xl border border-neutral-200 bg-white p-4">
                <h2 class="text-sm font-semibold text-neutral-900">Выручка по дням (30 дней)</h2>
                <div class="mt-3 h-[280px]">
                  <canvas id="analytics-orders-chart"></canvas>
                  <div id="analytics-orders-empty"
                    class="analytics-empty hidden h-full items-center justify-center text-center text-neutral-500">
                  </div>
                </div>
              </article>
              <article class="rounded-2xl border border-neutral-200 bg-white p-4">
                <h2 class="text-sm font-semibold text-neutral-900">Разбивка выручки</h2>
                <div class="mt-3 h-[280px]">
                  <canvas id="analytics-tariff-chart"></canvas>
                  <div id="analytics-tariff-empty"
                    class="analytics-empty hidden h-full items-center justify-center text-center text-neutral-500">
                  </div>
                </div>
              </article>
            </div>
            <article class="rounded-2xl border border-neutral-200 bg-white p-4">
              <h2 class="text-sm font-semibold text-neutral-900">Распределение UNQ Score</h2>
              <div class="mt-3 h-[260px]">
                <canvas id="analytics-score-distribution-chart"></canvas>
                <div id="analytics-score-empty"
                  class="analytics-empty hidden h-full items-center justify-center text-center text-neutral-500"></div>
              </div>
            </article>
          </section>
          <section class="space-y-2">
            <h3 class="text-sm font-semibold text-neutral-900">Инсайты</h3>
            <article class="rounded-2xl border border-neutral-200 bg-white p-4">
              <h2 class="text-sm font-semibold text-neutral-900">Топ-10 паттернов ищут, но не покупают</h2>
              <div class="mt-3 overflow-hidden rounded-xl border border-neutral-200">
                <table class="min-w-full text-left text-sm">
                  <thead class="bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500">
                    <tr>
                      <th class="px-3 py-2">Паттерн</th>
                      <th class="px-3 py-2">Проверок</th>
                    </tr>
                  </thead>
                  <tbody id="analytics-checker-table"></tbody>
                </table>
              </div>
            </article>
          </section>

        </section>
        <section id="tab-orders" class="<%= pageActiveTab === 'orders' ? '' : 'hidden' %> space-y-4">
          <header class="rounded-2xl border border-neutral-200 bg-white p-4">
            <h2 class="text-base font-bold text-neutral-900">Заявки</h2>
            <p class="mt-1 text-sm text-neutral-600">Управление заявками на покупку slug и тарифа.</p>
          </header>
          <section class="rounded-2xl border border-neutral-200 bg-white p-4">
            <h3 class="text-sm font-semibold text-neutral-900">Фильтры заявок</h3>
            <form id="orders-filters" class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Поиск</span>
                <input name="q" type="text" placeholder="Имя, slug, контакт"
                  class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Статус</span>
                <select name="status" class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="all">Все статусы</option>
                  <option value="new">Новая</option>
                  <option value="contacted">Связались</option>
                  <option value="paid">Оплачена</option>
                  <option value="approved">Активирована</option>
                  <option value="rejected">Отклонена</option>
                </select>
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Тариф</span>
                <select name="tariff" class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="all">Все тарифы</option>
                  <option value="premium">Премиум</option>
                </select>
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Дата с</span>
                <input type="date" name="dateFrom"
                  class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">Дата по</span>
                <input type="date" name="dateTo"
                  class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <input type="hidden" name="page" value="1" />
              <div class="col-span-full flex flex-wrap items-end justify-end gap-2">
                <button type="submit"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Применить</button>
                <button type="reset"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Сбросить</button>
                <a id="orders-export-link" href="/api/admin/orders/export.csv"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">
                  Скачать CSV
                </a>
              </div>
            </form>
          </section>
          <section class="space-y-2">
            <h3 class="text-sm font-semibold text-neutral-900">Список заявок</h3>
            <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
              <div class="overflow-x-auto">
                <table class="min-w-[980px] w-full text-left text-sm">
                  <thead class="bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500">
                    <tr>
                      <th class="px-4 py-3">Дата</th>
                      <th class="px-4 py-3">Пользователь</th>
                      <th class="px-4 py-3">Slug</th>
                      <th class="px-4 py-3 text-right">Цена slug</th>
                      <th class="px-4 py-3 text-right">Сумма</th>
                      <th class="px-4 py-3">Тариф</th>
                      <th class="px-4 py-3">Браслет</th>
                      <th class="px-4 py-3">Контакт</th>
                      <th class="px-4 py-3">Статус</th>
                      <th class="px-4 py-3 text-right">Действия</th>
                    </tr>
                  </thead>
                  <tbody id="orders-table"></tbody>
                </table>
              </div>
            </div>
            <div id="orders-pagination" class="flex items-center justify-end gap-2 text-sm text-neutral-600"></div>
          </section>
        </section>

        <section id="tab-purchases" class="<%= pageActiveTab === 'purchases' ? '' : 'hidden' %> space-y-4">
          <form id="purchases-filters"
            class="grid gap-3 rounded-2xl border border-neutral-200 bg-white p-4 md:grid-cols-5">
            <select name="type" class="rounded-xl border border-neutral-300 px-3 py-2 text-sm">
              <option value="all">Все типы</option>
              <option value="slug">Slug</option>
              <option value="premium_subscription_monthly">Premium monthly</option>
              <option value="basic_plan">Базовый тариф (legacy)</option>
              <option value="premium_plan">Премиум тариф (legacy)</option>
              <option value="upgrade_to_premium">Апгрейд до Премиум (legacy)</option>
            </select>
            <input name="user" type="text" placeholder="Пользователь"
              class="rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
            <input type="date" name="dateFrom" class="rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
            <input type="date" name="dateTo" class="rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
            <input type="hidden" name="page" value="1" />
            <button type="submit"
              class="inline-flex min-h-11 w-full items-center justify-center justify-self-start rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100 md:w-auto">Применить</button>
          </form>
          <div class="flex items-center justify-between gap-3">
            <p id="purchases-total" class="text-sm font-semibold text-neutral-800">Общая выручка: 0 сум</p>
            <a id="purchases-export-link" href="/api/admin/purchases/export.csv"
              class="rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Скачать
              CSV</a>
          </div>
          <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
              <table class="min-w-[980px] w-full text-left text-sm">
                <thead class="bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500">
                  <tr>
                    <th class="px-4 py-3">Дата</th>
                    <th class="px-4 py-3">Пользователь</th>
                    <th class="px-4 py-3">Тип</th>
                    <th class="px-4 py-3">Slug</th>
                    <th class="px-4 py-3">Сумма</th>
                    <th class="px-4 py-3">Одобрил</th>
                  </tr>
                </thead>
                <tbody id="purchases-table"></tbody>
              </table>
            </div>
          </div>
          <div id="purchases-pagination" class="flex items-center justify-end gap-2 text-sm text-neutral-600"></div>
          <form id="pricing-settings-form"
            class="grid gap-3 rounded-2xl border border-neutral-200 bg-white p-4 md:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.08em] text-neutral-500">Premium
                monthly (USD)</span>
              <input type="number" min="0" step="0.01" name="planPremiumMonthlyPriceUsd"
                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              <span class="mt-1 block text-xs text-neutral-500">$2 по умолчанию</span>
            </label>
            <label class="block">
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.08em] text-neutral-500">Premium
                monthly (UZS)</span>
              <input type="number" min="0" name="planPremiumMonthlyPriceUzs"
                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              <span class="mt-1 block text-xs text-neutral-500">Цена за 1 месяц Premium</span>
            </label>
            <label class="block">
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.08em] text-neutral-500">Подпись под
                тарифами</span>
              <input type="text" name="pricingFootnote"
                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
            </label>
            <div class="md:col-span-2">
              <button type="submit"
                class="interactive-btn min-h-11 rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">Сохранить
                тарифы</button>
            </div>
          </form>
        </section>

        <section id="tab-payment-cards" class="<%= pageActiveTab === 'payment-cards' ? '' : 'hidden' %> space-y-4">
          <header class="rounded-xl border border-neutral-200 bg-white p-4 shadow-sm">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0">
                <h2 class="text-base font-bold text-neutral-900">Payment карточки</h2>
                <p class="mt-1 max-w-3xl text-sm leading-6 text-neutral-600">Отдельные страницы реквизитов для точек профиля. Профильные данные берутся из основной визитки, а адрес и реквизиты хранятся в Payment-странице.</p>
              </div>
              <div class="flex flex-wrap gap-2">
                <a id="payment-cards-open-public" href="#" target="_blank" rel="noopener noreferrer"
                  class="inline-flex hidden min-h-10 items-center justify-center rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">Открыть страницу</a>
                <button id="payment-cards-create" type="button"
                  class="interactive-btn inline-flex min-h-10 items-center justify-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">Создать</button>
              </div>
            </div>
          </header>

          <div id="payment-cards-selected-user"
            class="hidden rounded-xl border border-neutral-200 bg-white p-4 text-sm text-neutral-700 shadow-sm"></div>

          <nav class="overflow-x-auto rounded-xl border border-neutral-200 bg-white p-1 shadow-sm" aria-label="Payment workflow">
            <div class="grid min-w-[620px] grid-cols-4 gap-1 sm:min-w-0">
              <button type="button" data-payment-panel-tab="profiles"
                class="rounded-lg px-3 py-2 text-sm font-semibold text-neutral-600 transition hover:bg-neutral-100">Профили</button>
              <button type="button" data-payment-panel-tab="pages"
                class="rounded-lg px-3 py-2 text-sm font-semibold text-neutral-600 transition hover:bg-neutral-100">Страницы</button>
              <button type="button" data-payment-panel-tab="editor"
                class="rounded-lg px-3 py-2 text-sm font-semibold text-neutral-600 transition hover:bg-neutral-100">Редактор</button>
              <button type="button" data-payment-panel-tab="preview"
                class="rounded-lg px-3 py-2 text-sm font-semibold text-neutral-600 transition hover:bg-neutral-100">Превью</button>
            </div>
          </nav>

          <section data-payment-panel="profiles" class="rounded-xl border border-neutral-200 bg-white p-4 shadow-sm">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
