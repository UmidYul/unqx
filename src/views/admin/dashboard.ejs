          <div class="w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-bold">Активация заявки</h3>
              <button type="button" id="activation-close-btn"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="activation-form" class="mt-4 space-y-3">
              <input type="hidden" name="orderId" />
              <label class="block text-sm font-medium text-neutral-700">
                Тариф
                <select name="tariff" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="basic">Базовый</option>
                  <option value="premium">Премиум</option>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Тема
                <select name="theme" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="default_dark">Obsidian Noir</option>
                  <option value="arctic">Glacier Platinum</option>
                  <option value="linen">Imperial Linen</option>
                  <option value="marble">Carrara Prestige</option>
                  <option value="forest">Emerald Reserve</option>
                  <option value="sage_luxe">Verdant Luxe</option>
                  <option value="midnight_obsidian">Midnight Obsidian</option>
                  <option value="golden_noir">Noir Aureate</option>
                  <option value="aurora_codex">Aurora Scriptum</option>
                  <option value="nebula_glass">Liquid Glass</option>
                </select>
              </label>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Активировать</button>
            </form>
          </div>
        </div>

        <div id="qr-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4"
          aria-hidden="true">
          <div class="w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="flex items-center justify-between">
              <h3 class="flex items-center gap-2 text-lg font-bold">
                <img src="/brand/logo.PNG" alt="UNQX"
                  class="h-6 w-6 rounded-md border border-neutral-200 bg-white p-0.5" />
                <span>QR-код <span id="qr-title-slug"></span></span>
              </h3>
              <button type="button"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                data-close-modal aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <div class="mt-4 flex justify-center">
              <div class="rounded-xl border border-neutral-200 p-3" id="qr-svg-wrap"></div>
            </div>

            <p id="qr-error" class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>

            <div class="mt-4 flex flex-col gap-2 sm:flex-row">
              <button type="button" id="download-qr-png"
                class="w-full rounded-xl bg-neutral-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">
                Скачать PNG 1000x1000
              </button>
              <button type="button" id="download-qr-svg"
                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-800 transition hover:bg-neutral-100">
                Скачать SVG
              </button>
            </div>

            <div class="hidden">
              <canvas id="qr-canvas" width="1000" height="1000"></canvas>
            </div>
          </div>
        </div>

        <div id="testimonial-edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="w-full max-w-lg rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-bold">Редактировать отзыв</h3>
              <button type="button" id="testimonial-edit-close-btn"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="testimonial-edit-form" class="mt-4 space-y-3">
              <input type="hidden" name="id" />
              <label class="block text-sm font-medium text-neutral-700">
                Имя
                <input name="name" type="text"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Slug
                <input name="slug" type="text" maxlength="6"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm font-mono uppercase"
                  required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Тариф
                <select name="tariff" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="basic">Базовый</option>
                  <option value="premium">Премиум</option>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Текст
                <textarea name="text" rows="3"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required></textarea>
              </label>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Сохранить</button>
            </form>
          </div>
        </div>

        <script nonce="<%= cspNonce %>" id="admin-dashboard-query"
          type="application/json"><%- JSON.stringify(pageQuery) %></script>
        <script nonce="<%= cspNonce %>" src="/js/admin-layout.js"></script>
        <script nonce="<%= cspNonce %>" src="/js/admin-dialogs.js"></script>
        <script nonce="<%= cspNonce %>" src="/vendor/sortablejs/Sortable.min.js"></script>
        <script nonce="<%= cspNonce %>" src="/vendor/qrcode/qrcode.min.js"></script>
        <script nonce="<%= cspNonce %>" src="/vendor/chartjs/chart.umd.min.js"></script>
        <script nonce="<%= cspNonce %>" src="/js/admin-dashboard.js"></script>
        <script nonce="<%= cspNonce %>" src="/js/admin-features.js"></script>
        <script nonce="<%= cspNonce %>" src="/js/admin-settings.js"></script>
  </body>

  </html>
