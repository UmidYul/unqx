          <div class="modal-panel max-h-[88vh] w-full max-w-4xl overflow-y-auto rounded-2xl bg-white p-5" role="dialog"
            aria-modal="true" aria-labelledby="flash-sale-edit-title">
            <div class="modal-header-safe flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Flash Sale</p>
                <h3 id="flash-sale-edit-title" class="mt-1 text-lg font-bold text-neutral-900">Редактирование акции</h3>
                <p class="mt-1 text-sm text-neutral-600">Меняйте текст, правила, период и способ уведомления в одном окне.</p>
              </div>
              <button type="button" id="flash-sale-edit-close-btn"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <form id="flash-sale-edit-form" class="admin-flash-form mt-5 space-y-5">
              <input type="hidden" name="id" />

              <div class="admin-flash-form-grid">
                <label class="admin-flash-field md:col-span-2">
                  <span class="admin-flash-label">Название акции</span>
                  <input name="title" type="text" placeholder="Название акции" class="admin-flash-input" required />
                </label>
                <label class="admin-flash-field">
                  <span class="admin-flash-label">Скидка</span>
                  <input name="discountPercent" type="number" min="1" max="95" class="admin-flash-input" required />
                </label>
                <label class="admin-flash-field">
                  <span class="admin-flash-label">Тип условия</span>
                  <select name="conditionType" class="admin-flash-input">
                    <option value="all">Все UNQ</option>
                    <option value="pattern_000">UNQ с цифрами 000</option>
                    <option value="pattern_aaa">UNQ с одинаковыми буквами</option>
                    <option value="sequential_digits">UNQ с последовательными цифрами</option>
                    <option value="custom">Кастомные правила</option>
                  </select>
                </label>
                <label class="admin-flash-field md:col-span-4">
                  <span class="admin-flash-label">Текст баннера и модалки</span>
                  <textarea name="description" rows="3"
                    placeholder="Что увидит пользователь в баннере и модалке"
                    class="admin-flash-textarea"></textarea>
                  <span class="admin-flash-help">Здесь лучше сразу объяснить механику акции простым языком.</span>
                </label>
              </div>

              <div class="admin-flash-subgrid hidden" data-flash-custom-wrap>
                <div class="admin-flash-subgrid-head">
                  <div>
                    <p class="admin-flash-section-title">Кастомные условия</p>
                    <p class="admin-flash-section-text">Можно редактировать и включающие правила, и исключения, и режим совпадения.</p>
                  </div>
                  <label class="admin-flash-field admin-flash-field--compact">
                    <span class="admin-flash-label">Совпадение</span>
                    <select name="conditionMatchMode" class="admin-flash-input">
                      <option value="any">Достаточно одного правила</option>
                      <option value="all">Нужно совпасть со всеми правилами</option>
                    </select>
                  </label>
                </div>
                <div class="admin-flash-form-grid">
                  <label class="admin-flash-field md:col-span-2">
                    <span class="admin-flash-label">Что участвует в акции</span>
                    <textarea name="conditionIncludeInput" rows="5" placeholder="AAA000&#10;AAA***&#10;digits:000"
                      class="admin-flash-textarea font-mono uppercase"></textarea>
                  </label>
                  <label class="admin-flash-field md:col-span-2">
                    <span class="admin-flash-label">Что исключить</span>
                    <textarea name="conditionExcludeInput" rows="5" placeholder="BBB000&#10;letters:XYZ"
                      class="admin-flash-textarea font-mono uppercase"></textarea>
                  </label>
                </div>
              </div>

              <div class="admin-flash-form-grid">
                <label class="admin-flash-field">
                  <span class="admin-flash-label">Старт акции</span>
                  <input name="startsAt" type="datetime-local" class="admin-flash-input" required />
                </label>
                <label class="admin-flash-field">
                  <span class="admin-flash-label">Конец акции</span>
                  <input name="endsAt" type="datetime-local" class="admin-flash-input" required />
                </label>
                <label class="admin-flash-toggle">
                  <input type="checkbox" name="isActive" />
                  <span class="admin-flash-toggle-copy">
                    <strong>Акция включена</strong>
                    <small>Можно выключить без удаления.</small>
                  </span>
                </label>
                <label class="admin-flash-toggle">
                  <input type="checkbox" name="notifyTelegram" />
                  <span class="admin-flash-toggle-copy">
                    <strong>Уведомлять Telegram</strong>
                    <small>Отправлять уведомление при старте.</small>
                  </span>
                </label>
                <label class="admin-flash-field md:col-span-4">
                  <span class="admin-flash-label">Telegram target</span>
                  <input name="telegramTarget" type="text" placeholder="@channel или chat_id"
                    class="admin-flash-input" />
                </label>
              </div>

              <div class="flex flex-col-reverse gap-2 border-t border-neutral-200 pt-4 sm:flex-row sm:justify-end">
                <button type="button" id="flash-sale-edit-cancel"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">
                  Закрыть
                </button>
                <button type="submit"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">
                  Сохранить изменения
                </button>
              </div>
            </form>
          </div>
        </div>

