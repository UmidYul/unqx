                  <option value="anime_blush">Anime Blush</option>
                  <option value="cheetah_spots">Cheetah Skin</option>
                  <option value="serpent_scale">Serpent Scale</option>
                  <option value="color_red">Color Red</option>
                  <option value="color_orange">Color Orange</option>
                  <option value="color_yellow">Color Yellow</option>
                  <option value="color_green">Color Green</option>
                  <option value="color_teal">Color Teal</option>
                  <option value="color_blue">Color Blue</option>
                  <option value="color_purple">Color Purple</option>
                  <option value="color_pink">Color Pink</option>
                </select>
              </label>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Активировать</button>
            </form>
          </div>
        </div>

        <div id="qr-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4"
          aria-hidden="true">
          <div class="modal-panel w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 class="flex items-center gap-2 text-lg font-bold">
                <img src="/brand/logo.PNG" alt="UNQX"
                  class="h-6 w-6 rounded-md border border-neutral-200 bg-white p-0.5" />
                <span>QR-код <span id="qr-title-slug"></span></span>
              </h3>
              <button type="button"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                data-close-modal aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <div class="mt-4 flex justify-center">
              <div class="rounded-xl border border-neutral-200 p-3" id="qr-svg-wrap"></div>
            </div>

            <p id="qr-error" class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>

            <div class="mt-4 flex flex-col gap-2 sm:flex-row">
              <button type="button" id="download-qr-png"
                class="w-full rounded-xl bg-neutral-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">
                Скачать PNG 1000x1000
              </button>
              <button type="button" id="download-qr-svg"
                class="w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-800 transition hover:bg-neutral-100">
                Скачать SVG
              </button>
            </div>

            <div class="hidden">
              <canvas id="qr-canvas" width="1000" height="1000"></canvas>
            </div>
          </div>
        </div>

        <div id="testimonial-edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="modal-panel w-full max-w-lg rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 class="text-lg font-bold">Редактировать отзыв</h3>
              <button type="button" id="testimonial-edit-close-btn"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="testimonial-edit-form" class="mt-4 space-y-3">
              <input type="hidden" name="id" />
              <label class="block text-sm font-medium text-neutral-700">
                Имя
                <input name="name" type="text"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Slug
                <input name="slug" type="text" maxlength="6"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm font-mono uppercase"
                  required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Тариф
                <select name="tariff" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="premium">Премиум</option>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Текст
                <textarea name="text" rows="3"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required></textarea>
              </label>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Сохранить</button>
            </form>
          </div>
        </div>

        <div id="user-create-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="modal-panel w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 class="text-lg font-bold">Создать пользователя</h3>
              <button type="button" id="user-create-close"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="user-create-form" class="mt-4 space-y-3">
              <label class="block text-sm font-medium text-neutral-700">
                Имя
                <input name="name" type="text" maxlength="120"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Город
                <select name="city" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required>
                  <option value="">Выберите город</option>
                  <%- include('../partials/city-options') %>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Логин
                <input name="login" type="text" maxlength="190"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required />
                <span id="user-create-login-status" class="mt-1 block text-xs text-neutral-500"></span>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Пароль
                <input name="password" type="password" minlength="8" autocomplete="new-password"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" required />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Тип профиля
                <select name="profileType" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="person" selected>Личность</option>
                  <option value="company">Компания</option>
                </select>
              </label>
              <fieldset class="block text-sm font-medium text-neutral-700" data-badge-types-field>
                <legend class="text-sm font-medium text-neutral-700">Метки профиля</legend>
                <div class="mt-1 space-y-2 rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="unqx_staff" class="h-4 w-4" />
                    <span>Сотрудник UNQX</span>
                  </label>
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="government" class="h-4 w-4" />
                    <span>Гос. служащий</span>
                  </label>
                </div>
              </fieldset>
              <label class="block text-sm font-medium text-neutral-700">
                Тариф
                <select name="plan" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <option value="none">Без тарифа</option>
                  <option value="premium">Премиум</option>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Slug / username (AAA000, 0-999 или A-Z)
                <input name="slug" type="text" maxlength="6" autocapitalize="characters" autocomplete="off"
                  inputmode="text" pattern="([A-Za-z]{3}[0-9]{3}|0|[1-9][0-9]{0,2}|[A-Za-z]{1,3})" placeholder="A или ABC123"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 font-mono text-sm uppercase tracking-wide" />
                <span id="user-create-slug-status" class="mt-1 block text-xs text-neutral-500"></span>
                <span id="user-create-slug-price" class="mt-1 block text-xs text-neutral-500"></span>
                <span class="mt-1 block text-xs text-neutral-500">Username выдаётся только админом или менеджером. Для
                  менеджера тариф и slug обязательны для мгновенной активации.</span>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Email для восстановления (опционально)
                <input name="email" type="email" maxlength="190"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
                <span id="user-create-email-status" class="mt-1 block text-xs text-neutral-500"></span>
              </label>
              <p id="user-create-error" class="hidden text-xs text-red-700"></p>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Создать</button>
            </form>
          </div>
        </div>

        <div id="user-verification-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="modal-panel w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 class="text-lg font-bold">Управление верификацией</h3>
              <button type="button" id="user-verification-close"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="user-verification-form" class="mt-4 space-y-3">
              <input type="hidden" name="userId" />
              <p id="user-verification-user" class="text-sm font-medium text-neutral-700"></p>
              <label class="block text-sm font-medium text-neutral-700">
                Статус верификации
                <select name="status" class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm"
                  required>
                  <option value="verified">Активировать верификацию</option>
                  <option value="unverified">Снять верификацию</option>
                </select>
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Место работы
                <input name="company" type="text" maxlength="160"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <label class="block text-sm font-medium text-neutral-700">
                Должность
                <input name="role" type="text" maxlength="120"
                  class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
              </label>
              <fieldset class="block text-sm font-medium text-neutral-700" data-badge-types-field>
                <legend class="text-sm font-medium text-neutral-700">Метки профиля</legend>
                <div class="mt-1 space-y-2 rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="unqx_staff" class="h-4 w-4" />
                    <span>Сотрудник UNQX</span>
                  </label>
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="government" class="h-4 w-4" />
                    <span>Гос. служащий</span>
                  </label>
                </div>
              </fieldset>
              <p id="user-verification-error" class="hidden text-xs text-red-700"></p>
              <button type="submit"
                class="w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-700">Сохранить</button>
            </form>
          </div>
        </div>

        <div id="verification-detail-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="modal-panel max-h-[88vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 id="verification-detail-title" class="text-lg font-bold">Заявка на верификацию</h3>
              <button type="button" id="verification-detail-close"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <div id="verification-detail-body" class="mt-4 space-y-3 text-sm"></div>
            <div id="verification-detail-actions" class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end"></div>
          </div>
        </div>


        <div id="user-badge-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
          aria-hidden="true">
          <div class="modal-panel w-full max-w-md rounded-2xl bg-white p-5" role="dialog" aria-modal="true">
            <div class="modal-header-safe flex items-center justify-between">
              <h3 class="text-lg font-bold">Изменить бейдж</h3>
              <button type="button" id="user-badge-close"
                class="modal-close-corner inline-flex h-8 w-8 items-center justify-center rounded-lg border border-neutral-300 text-neutral-500 hover:text-neutral-900"
                aria-label="Закрыть">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <form id="user-badge-form" class="mt-4 space-y-3">
              <input type="hidden" name="userId" />
              <p id="user-badge-user" class="text-sm font-medium text-neutral-700"></p>
              <fieldset class="block text-sm font-medium text-neutral-700" data-badge-types-field>
                <legend class="text-sm font-medium text-neutral-700">Бейджи</legend>
                <div class="mt-1 space-y-2 rounded-xl border border-neutral-300 px-3 py-2 text-sm">
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="unqx_staff" class="h-4 w-4" />
                    <span>Сотрудник UNQX</span>
                  </label>
                  <label class="flex items-center gap-2 font-normal text-neutral-700">
                    <input type="checkbox" name="badgeTypes" value="government" class="h-4 w-4" />
                    <span>Гос. служащий</span>
                  </label>
                </div>
              </fieldset>
              <p id="user-badge-error" class="hidden text-xs text-red-700"></p>
