              <section class="admin-flash-builder rounded-[28px] border border-neutral-200 bg-white p-4 shadow-sm md:p-6">
                <div class="admin-flash-builder-head">
                  <div class="admin-flash-builder-copy">
                    <span class="admin-flash-builder-kicker">Flash Sale Builder</span>
                    <h3 class="admin-flash-builder-title">Создание акций без ручных правок</h3>
                    <p class="admin-flash-builder-text">
                      Опишите баннер, выберите тип условия, задайте правила и период. Для кастомных сценариев можно отдельно
                      указать, что участвует в скидке и что нужно исключить.
                    </p>
                  </div>
                  <div class="admin-flash-builder-note">
                    <p class="admin-flash-builder-note-title">Как писать правила</p>
                    <ul class="admin-flash-builder-note-list">
                      <li>`AAA000` = точный UNQ</li>
                      <li>`AAA***` или `***777` = маска</li>
                      <li>`letters:AAA` или `digits:000` = typed rule</li>
                      <li>Исключения указываются в отдельном блоке ниже</li>
                    </ul>
                  </div>
                </div>

                <form id="flash-sales-create-form" class="admin-flash-form mt-5 space-y-5">
                  <div class="admin-flash-form-grid">
                    <label class="admin-flash-field md:col-span-2">
                      <span class="admin-flash-label">Название акции</span>
                      <input name="title" type="text" placeholder="Например: Summer sportivouz"
                        class="admin-flash-input" required />
                    </label>
                    <label class="admin-flash-field">
                      <span class="admin-flash-label">Скидка</span>
                      <input name="discountPercent" type="number" min="1" max="95" placeholder="95"
                        class="admin-flash-input" required />
                    </label>
                    <label class="admin-flash-field">
                      <span class="admin-flash-label">Тип условия</span>
                      <select name="conditionType" class="admin-flash-input">
                        <option value="all">Все UNQ</option>
                        <option value="pattern_000">UNQ с цифрами 000</option>
                        <option value="pattern_aaa">UNQ с одинаковыми буквами</option>
                        <option value="sequential_digits">UNQ с последовательными цифрами</option>
                        <option value="custom">Кастомные правила</option>
                      </select>
                    </label>
                    <label class="admin-flash-field md:col-span-4">
                      <span class="admin-flash-label">Текст баннера и модалки</span>
                      <textarea name="description" rows="3"
                        placeholder="Коротко объясните, что получит пользователь, какие UNQ участвуют и почему акция интересна."
                        class="admin-flash-textarea"></textarea>
                      <span class="admin-flash-help">Этот текст увидят пользователи в баннере и в flash sale модалке.</span>
                    </label>
                  </div>

                  <div class="admin-flash-subgrid hidden" data-flash-custom-wrap>
                    <div class="admin-flash-subgrid-head">
                      <div>
                        <p class="admin-flash-section-title">Кастомные условия</p>
                        <p class="admin-flash-section-text">Опишите правила, которые включают скидку, и отдельно укажите исключения.</p>
                      </div>
                      <label class="admin-flash-field admin-flash-field--compact">
                        <span class="admin-flash-label">Совпадение</span>
                        <select name="conditionMatchMode" class="admin-flash-input">
                          <option value="any">Достаточно одного правила</option>
                          <option value="all">Нужно совпасть со всеми правилами</option>
                        </select>
                      </label>
                    </div>
                    <div class="admin-flash-form-grid">
                      <label class="admin-flash-field md:col-span-2">
                        <span class="admin-flash-label">Что участвует в акции</span>
                        <textarea name="conditionIncludeInput" rows="4"
                          placeholder="AAA000&#10;AAA***&#10;***777&#10;letters:AAA"
                          class="admin-flash-textarea font-mono uppercase"></textarea>
                        <span class="admin-flash-help">Можно писать через новую строку, пробел или запятую.</span>
                      </label>
                      <label class="admin-flash-field md:col-span-2">
                        <span class="admin-flash-label">Что исключить</span>
                        <textarea name="conditionExcludeInput" rows="4"
