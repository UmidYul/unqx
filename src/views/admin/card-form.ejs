<%
  const pageTitle = typeof title === "string" && title ? title : "Редактор визитки";
  const pageMode = typeof mode === "string" && mode ? mode : "select-owner";
  const pageCardId = typeof cardId === "string" && cardId ? cardId : "";
  const pageDashboardBasePath =
    typeof dashboardBasePath === "string" && dashboardBasePath ? dashboardBasePath : "/admin/dashboard";

  const presets = typeof themePresets === "object" && themePresets ? themePresets : {};
  const signatureThemes = Array.isArray(presets.signatureThemes) ? presets.signatureThemes : [];
  const colorThemes = Array.isArray(presets.colorThemes) ? presets.colorThemes : [];
  const avatarFrames = Array.isArray(presets.avatarFrames) ? presets.avatarFrames : [];
  const emojiBackgroundPacks = Array.isArray(presets.emojiBackgroundPacks) ? presets.emojiBackgroundPacks : [];

  const pageOwnerSearchQuery = typeof ownerSearchQuery === "string" ? ownerSearchQuery : "";
  const pageOwnerPickerError = typeof ownerPickerError === "string" ? ownerPickerError : "";
  const pageOwnerSearchResults = Array.isArray(ownerSearchResults) ? ownerSearchResults : [];

  const frameClassName = (value) => String(value || "").replace(/_/g, "-");
  const emojiPackClassName = (value) => String(value || "").replace(/_/g, "-");
  const ownerPlanLabel = (plan) => (String(plan || "").trim().toLowerCase() === "premium" ? "Премиум" : "Без тарифа");
  const ownerStatusMeta = (status) => {
    const normalized = String(status || "").trim().toLowerCase();
    if (normalized === "blocked") {
      return { className: "is-blocked", label: "Заблокирован" };
    }
    if (normalized === "paused" || normalized === "inactive") {
      return { className: "is-paused", label: "На паузе" };
    }
    return { className: "is-active", label: "Активен" };
  };

  const renderEmojiPackIcon = (id, className) => {
    switch (String(id || "").trim().toLowerCase()) {
      case "ghosts":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="M6.4 17.8c-.8 0-1.4-.6-1.4-1.3V12c0-2.8 2.2-5 4.9-5 2.8 0 5.1 2.2 5.1 5v4.5c0 .7-.6 1.3-1.3 1.3-.6 0-1.1-.3-1.5-.8-.3.5-.8.8-1.5.8s-1.2-.3-1.6-.8c-.3.5-.8.8-1.5.8Z" fill="#F7F5FF" fill-opacity=".92"/>
            <path d="M12.2 16.8c-.6 0-1-.3-1.4-.7-.3.5-.8.7-1.3.7-.7 0-1.2-.5-1.2-1.1v-3.2c0-2 1.6-3.6 3.6-3.6s3.6 1.6 3.6 3.6v3.2c0 .6-.5 1.1-1.1 1.1-.5 0-1-.2-1.4-.7-.3.4-.7.7-1.4.7Z" fill="#DCE3FF" fill-opacity=".88"/>
            <circle cx="10.1" cy="12.1" r=".72" fill="#4B5563"/>
            <circle cx="13.4" cy="12.1" r=".72" fill="#4B5563"/>
            <circle cx="11.1" cy="13.2" r=".6" fill="#4B5563"/>
            <circle cx="14.3" cy="13.2" r=".6" fill="#4B5563"/>
          </svg>
        `;
      case "stars":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="M11.8 4.2 13 7.6l3.4 1.2-3.4 1.2-1.2 3.4-1.2-3.4-3.4-1.2 3.4-1.2 1.2-3.4Z" fill="#FFF8D6"/>
            <path d="m16.8 10.8.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7.7-1.9Z" fill="#DBEAFE"/>
            <circle cx="7.4" cy="14.8" r="1.2" fill="#FFFFFF" fill-opacity=".92"/>
            <circle cx="8.2" cy="8.1" r=".8" fill="#BFDBFE"/>
            <circle cx="15.9" cy="6.5" r=".7" fill="#FDE68A"/>
          </svg>
        `;
      case "lightning":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="m13.7 3.8-5.2 7.8h3.2l-1 8.6 5.7-8.2h-3.2l.5-8.2Z" fill="#FFE08A" stroke="#F6C65B" stroke-width="1" stroke-linejoin="round"/>
            <path d="M16.9 6.7c1 .4 1.8 1.1 2.2 2.1M6.6 15.2c.5.9 1.3 1.6 2.2 2" stroke="#FFF5C5" stroke-width="1.15" stroke-linecap="round" opacity=".9"/>
          </svg>
        `;
      case "crowns":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="m6 17 1.3-7 3.1 2.4L12 7l1.6 5.4 3.1-2.4L18 17H6Z" fill="#F8E2A0" stroke="#D5AE56" stroke-width="1.05" stroke-linejoin="round"/>
            <path d="M7.5 18.2h9" stroke="#FFF6D9" stroke-width="1.2" stroke-linecap="round"/>
            <circle cx="12" cy="13.8" r="1.2" fill="#FFF8DA"/>
            <circle cx="8.9" cy="14.1" r=".72" fill="#EFD086"/>
            <circle cx="15.1" cy="14.1" r=".72" fill="#EFD086"/>
          </svg>
        `;
      case "webs":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="M12 4.6v14.8M4.6 12h14.8M7 7l10 10M17 7 7 17" stroke="#F3F4F6" stroke-width="1.05" stroke-linecap="round" opacity=".88"/>
            <path d="M8.2 8.2a5.4 5.4 0 0 1 7.6 0M6.8 12a7.2 7.2 0 0 1 10.4 0M8.2 15.8a5.4 5.4 0 0 0 7.6 0" stroke="#D1D5DB" stroke-width="1.05" stroke-linecap="round" fill="none" opacity=".92"/>
          </svg>
        `;
      case "hearts":
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <path d="m12 18-4-3.9c-1.7-1.6-1.7-4.3 0-5.9 1.3-1.2 3.3-1.2 4.6 0l.2.2.2-.2c1.3-1.2 3.3-1.2 4.6 0 1.7 1.6 1.7 4.3 0 5.9L12 18Z" fill="#F8AFC3"/>
            <path d="m16.8 9.6 1.1.3-.6.9.1 1.2-1-.5-1 .5.1-1.2-.7-.9 1.2-.3.4-1.1.4 1.1Z" fill="#FFF2F6"/>
            <path d="M8.7 9.8c.5-.8 1.3-1.3 2.2-1.3" stroke="#FFF3F7" stroke-width="1.15" stroke-linecap="round"/>
          </svg>
        `;
      case "none":
      default:
        return `
          <svg viewBox="0 0 24 24" class="${className}" aria-hidden="true" focusable="false">
            <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="4" fill="#FFFFFF" fill-opacity=".7" stroke="#9CA3AF" stroke-width="1.1"/>
            <path d="M8.2 15.8 15.8 8.2" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="9.1" cy="9.2" r=".95" fill="#D1D5DB"/>
          </svg>
        `;
    }
  };

  const renderThemeButton = (item) => `
    <button type="button" data-theme="${item.id}" class="admin-card-style-btn" aria-pressed="false">
      <span class="admin-card-style-btn-main">
        <span class="admin-card-style-swatch" style="${item.swatchStyle}"></span>
        <span class="admin-card-style-copy">
          <span class="admin-card-style-title">${item.label}</span>
        </span>
      </span>
    </button>
  `;

  const renderFrameButton = (item) => `
    <button type="button" data-avatar-frame="${item.id}" class="admin-card-style-btn" aria-pressed="false">
      <span class="admin-card-style-btn-main">
        <span class="admin-card-frame-swatch admin-card-frame-swatch--${frameClassName(item.id)}">
          <span class="admin-card-frame-swatch-core"></span>
          <span class="admin-card-frame-swatch-deco"></span>
        </span>
        <span class="admin-card-style-copy">
          <span class="admin-card-style-title">${item.label}</span>
        </span>
      </span>
    </button>
  `;

  const renderEmojiPackButton = (item) => `
    <button type="button" data-emoji-background-pack="${item.id}" class="admin-card-style-btn" aria-pressed="false">
      <span class="admin-card-style-btn-main">
        <span class="admin-card-emoji-pack-swatch admin-card-emoji-pack-swatch--${emojiPackClassName(item.id)}" style="${item.swatchStyle}">
          ${renderEmojiPackIcon(item.id, "admin-card-emoji-pack-svg")}
        </span>
        <span class="admin-card-style-copy">
          <span class="admin-card-style-title">${item.label}</span>
        </span>
      </span>
    </button>
  `;
%>
<!doctype html>
<html lang="ru">
<head>
  <%- include('../partials/head', { title: pageTitle, styles: ['/css/admin.css', '/css/public-card.css', '/css/admin-card-editor.css'] }) %>
  <link rel="stylesheet" href="/vendor/cropperjs/cropper.min.css" />
</head>
<body
  class="antialiased admin-card-editor-page"
  data-admin-layout="1"
  data-page="admin-card-editor"
  data-mode="<%= pageMode %>"
  data-card-id="<%= pageCardId %>"
>
  <%- include('../partials/admin-layout-start', { activeTab: 'cards', dashboardBasePath: pageDashboardBasePath }) %>
  <div class="admin-card-editor-shell">
    <% if (pageMode === 'select-owner') { %>
      <header class="admin-card-topbar">
        <div>
          <h1 class="text-3xl font-black text-neutral-950">Новая визитка</h1>
        </div>
        <a
          href="<%= pageDashboardBasePath %>?tab=cards"
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
        >
          Назад к списку
        </a>
      </header>

      <% if (pageOwnerPickerError) { %>
        <div class="admin-card-page-error"><%= pageOwnerPickerError %></div>
      <% } %>

      <section class="admin-card-owner-search">
        <form method="get" action="/admin/cards/new" class="admin-card-owner-search-grid">
          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Поиск владельца</span>
            <input
              type="text"
              name="q"
              value="<%= pageOwnerSearchQuery %>"
              placeholder="Имя, username, email, telegram, UUID"
              class="admin-card-input"
              autocomplete="off"
            />
          </label>
          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center self-end rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800"
          >
            Найти
          </button>
        </form>

        <div class="mt-6">
          <% if (!pageOwnerSearchQuery) { %>
            <div class="admin-card-empty">
              <p class="text-base font-semibold text-neutral-900">Сначала найди пользователя</p>
            </div>
          <% } else if (!pageOwnerSearchResults.length) { %>
            <div class="admin-card-empty">
              <p class="text-base font-semibold text-neutral-900">Ничего не найдено</p>
            </div>
          <% } else { %>
            <div class="admin-card-owner-results">
              <% pageOwnerSearchResults.forEach((item) => { const statusMeta = ownerStatusMeta(item.status); %>
                <article class="admin-card-owner-card">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h3><%= item.name %></h3>
                      <p><%= item.username ? `@${item.username}` : (item.telegramUsername ? `@${item.telegramUsername}` : (item.email || item.id)) %></p>
                    </div>
                    <span class="admin-card-status-pill <%= statusMeta.className %>"><%= statusMeta.label %></span>
                  </div>

                  <div class="admin-card-owner-tags">
                    <span class="admin-card-owner-pill"><%= ownerPlanLabel(item.plan) %></span>
                    <span class="admin-card-owner-pill"><%= item.profileCardId ? 'Визитка уже есть' : 'Визитка ещё не создана' %></span>
                    <% (item.slugs || []).forEach((slug) => { %>
                      <span class="admin-card-owner-pill"><%= slug.isPrimary ? 'Primary: ' : '' %><%= slug.fullSlug %></span>
                    <% }) %>
                  </div>

                  <form method="get" action="/admin/cards/new" class="mt-4">
                    <input type="hidden" name="ownerId" value="<%= item.id %>" />
                    <% if (pageOwnerSearchQuery) { %>
                      <input type="hidden" name="q" value="<%= pageOwnerSearchQuery %>" />
                    <% } %>
                    <button
                      type="submit"
                      class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800"
                    >
                      <%= item.profileCardId ? 'Открыть' : 'Создать' %>
                    </button>
                  </form>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    <% } else if (pageMode === 'missing') { %>
      <header class="admin-card-topbar">
        <div>
          <h1 class="text-3xl font-black text-neutral-950">Визитка не найдена</h1>
        </div>
      </header>
      <div class="admin-card-empty">
        <p class="text-base font-semibold text-neutral-900">ID: <%= pageCardId || '—' %></p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a
            href="<%= pageDashboardBasePath %>?tab=cards"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
          >
            К списку визиток
          </a>
          <a
            href="/admin/cards/new"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800"
          >
            Выбрать другого владельца
          </a>
        </div>
      </div>
    <% } else { %>
      <header class="admin-card-topbar">
        <div>
          <h1 class="text-3xl font-black text-neutral-950">Редактор визитки</h1>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/admin/cards/new"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
          >
            Новая визитка
          </a>
          <a
            href="<%= pageDashboardBasePath %>?tab=cards"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800"
          >
            К списку визиток
          </a>
        </div>
      </header>

      <div id="admin-card-page-error" class="admin-card-page-error hidden"></div>

      <section class="admin-card-meta-grid">
        <article class="admin-card-meta-card">
          <p class="admin-card-meta-label">Владелец</p>
          <div class="admin-card-meta-main">
            <h2 id="admin-card-owner-name" class="admin-card-meta-title">—</h2>
            <p id="admin-card-owner-login" class="admin-card-meta-subtitle">—</p>
            <p id="admin-card-owner-plan" class="admin-card-meta-note">Тариф: —</p>
          </div>
          <div class="admin-card-meta-actions">
            <a
              id="admin-card-open-owner-link"
              href="#"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
            >
              Открыть профиль
            </a>
          </div>
        </article>

        <article class="admin-card-meta-card">
          <p class="admin-card-meta-label">Slug</p>
          <div class="admin-card-meta-main">
            <h2 id="admin-card-primary-slug" class="admin-card-meta-title">—</h2>
            <p id="admin-card-primary-slug-status" class="admin-card-meta-subtitle">Статус slug: —</p>
            <p id="admin-card-primary-slug-note" class="admin-card-meta-note">—</p>
          </div>
          <div class="mt-4 admin-card-inline-field">
            <label for="admin-card-preview-slug-select">Slug</label>
            <select id="admin-card-preview-slug-select" class="admin-card-select">
              <option value="">Нет slug</option>
            </select>
          </div>
          <div class="admin-card-meta-actions">
            <a
              id="admin-card-open-public-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
            >
              Открыть визитку
            </a>
          </div>
        </article>

        <article class="admin-card-meta-card">
          <p class="admin-card-meta-label">Управление</p>
          <div class="grid gap-3">
            <div class="admin-card-inline-field">
              <label for="admin-card-tariff-select">Тариф владельца</label>
              <select id="admin-card-tariff-select" class="admin-card-select">
                <option value="legacy">Без тарифа</option>
                <option value="premium">Премиум</option>
              </select>
            </div>
          </div>
          <div class="admin-card-meta-actions">
            <button
              type="button"
              id="admin-card-tariff-apply"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100"
            >
              Обновить тариф
            </button>
            <button
              type="button"
              id="admin-card-active-toggle"
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800"
            >
              Переключить активность
            </button>
          </div>
        </article>

        <article class="admin-card-meta-card">
          <p class="admin-card-meta-label">Верификация</p>
          <div class="admin-card-meta-main">
            <h2 id="admin-card-verification-state" class="admin-card-meta-title">—</h2>
            <p id="admin-card-verified-company" class="admin-card-meta-subtitle">Компания: —</p>
            <p id="admin-card-verification-request" class="admin-card-meta-note">—</p>
          </div>
          <div class="mt-4 admin-card-inline-field">
            <label for="admin-card-verified-company-input">Компания</label>
            <input id="admin-card-verified-company-input" type="text" maxlength="160" class="admin-card-input" />
          </div>
        </article>
      </section>

      <form id="card-editor-form" novalidate>
        <div class="admin-card-editor-grid">
          <div class="admin-card-editor-column">
            <nav id="admin-card-categories" class="admin-card-categories" aria-label="Категории редактора">
              <button type="button" class="admin-card-category-btn is-active" data-card-category="main" aria-pressed="true">
                <span class="admin-card-category-label">Основное</span>
              </button>
              <button type="button" class="admin-card-category-btn" data-card-category="links" aria-pressed="false">
                <span class="admin-card-category-label">Ссылки и теги</span>
              </button>
              <button type="button" class="admin-card-category-btn" data-card-category="contacts" aria-pressed="false">
                <span class="admin-card-category-label">Контакты</span>
              </button>
              <button type="button" class="admin-card-category-btn" data-card-category="design" aria-pressed="false">
                <span class="admin-card-category-label">Оформление</span>
              </button>
              <button type="button" class="admin-card-category-btn" data-card-category="pets" aria-pressed="false">
                <span class="admin-card-category-label">Животные</span>
              </button>
            </nav>

            <div id="card-form-error" class="admin-card-page-error hidden mb-4"></div>

            <section class="admin-card-panel" data-card-panel="main">
              <div class="admin-card-panel-head">
                <h3>Основное</h3>
              </div>

              <div class="admin-card-editor-stack">
                <div class="admin-card-avatar-grid">
                  <div class="admin-card-avatar-preview-box">
                    <div class="admin-card-avatar-preview-ring">
                      <img id="admin-card-avatar-current" src="" alt="Avatar" class="hidden" />
                      <span id="admin-card-avatar-fallback" class="admin-card-avatar-fallback">Нет аватара</span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-semibold text-neutral-900">Аватар</p>
                    </div>
                  </div>

                  <div class="admin-card-editor-stack">
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Файл аватара</span>
                      <input id="admin-card-avatar-file" type="file" accept="image/png,image/jpeg,image/webp" class="admin-card-input" />
                    </label>

                    <div id="admin-card-avatar-crop-wrap" class="admin-card-crop-wrap hidden">
                      <div class="admin-card-crop-stage">
                        <img id="admin-card-avatar-crop-image" src="" alt="Crop preview" />
                      </div>
                    </div>

                    <div class="admin-card-avatar-actions">
                      <button type="button" id="admin-card-avatar-upload" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">
                        Сохранить аватар
                      </button>
                      <button type="button" id="admin-card-avatar-remove" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-50">
                        Удалить аватар
                      </button>
                    </div>
                  </div>
                </div>

                <div class="admin-card-grid-2">
                  <label class="block is-span-2">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Имя</span>
                    <input id="admin-card-name" type="text" maxlength="120" class="admin-card-input" />
                  </label>

                  <label class="block is-span-2">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Роль / заголовок</span>
                    <input id="admin-card-role" type="text" maxlength="120" class="admin-card-input" />
                  </label>

                  <label class="block is-span-2">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Bio</span>
                    <textarea id="admin-card-bio" maxlength="120" rows="4" class="admin-card-textarea"></textarea>
                    <p id="admin-card-bio-counter" class="mt-2 admin-card-counter">0/120</p>
                  </label>

                  <label class="block is-span-2">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Нижний хэштег</span>
                    <input id="admin-card-hashtag" type="text" maxlength="50" class="admin-card-input" placeholder="#UNQX" />
                  </label>
                </div>
              </div>
            </section>

            <section class="admin-card-panel hidden" data-card-panel="links">
              <div class="admin-card-panel-head">
                <h3>Ссылки и теги</h3>
              </div>

              <div class="admin-card-editor-stack">
                <div>
                  <div class="admin-card-tags-toolbar">
                    <div>
                      <p class="admin-card-field-label">Теги</p>
                    </div>
                  </div>
                  <div class="admin-card-tags-input-row mt-3">
                    <input id="admin-card-tag-input" type="text" class="admin-card-input" placeholder="#Дизайнер" />
                    <button type="button" id="admin-card-tag-add" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">
                      Добавить тег
                    </button>
                  </div>
                  <div id="admin-card-tags-list" class="admin-card-tags-list mt-3"></div>
                </div>

                <div>
                  <div class="admin-card-buttons-toolbar">
                    <div>
                      <p class="admin-card-field-label">Кнопки</p>
                    </div>
                    <button type="button" id="admin-card-button-add" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-100">
                      Добавить кнопку
                    </button>
                  </div>
                  <div id="admin-card-buttons-list" class="admin-card-button-list mt-4"></div>
                </div>
              </div>
            </section>

            <section class="admin-card-panel hidden" data-card-panel="contacts">
              <div class="admin-card-panel-head">
                <h3>Контакты</h3>
              </div>

              <div class="admin-card-grid-2">
                <label class="block is-span-2">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Адрес</span>
                  <input id="admin-card-address" type="text" class="admin-card-input" />
                </label>

                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Индекс</span>
                  <input id="admin-card-postcode" type="text" maxlength="20" class="admin-card-input" />
                </label>

                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Email</span>
                  <input id="admin-card-email" type="email" maxlength="100" class="admin-card-input" />
                </label>

                <label class="block is-span-2">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Дополнительный телефон</span>
                  <input id="admin-card-extra-phone" type="text" maxlength="30" class="admin-card-input" />
                </label>
              </div>
            </section>

            <section class="admin-card-panel hidden" data-card-panel="design">
              <div class="admin-card-panel-head">
                <h3>Оформление</h3>
              </div>

              <div class="admin-card-editor-stack">
                <div>
                  <p class="admin-card-field-label">Темы</p>
                  <div id="admin-card-theme-options" class="admin-card-style-grid mt-3">
                    <% signatureThemes.forEach((item) => { %>
                      <%- renderThemeButton(item) %>
                    <% }) %>
                  </div>
                </div>

                <div>
                  <p class="admin-card-field-label">Сплошные цвета</p>
                  <div id="admin-card-color-theme-options" class="admin-card-style-grid is-compact mt-3">
                    <% colorThemes.forEach((item) => { %>
                      <%- renderThemeButton(item) %>
                    <% }) %>
                  </div>
                </div>

                <div>
                  <p class="admin-card-field-label">Цвет кнопки</p>
                  <div class="admin-card-color-row mt-3">
                    <input id="admin-card-custom-color" type="color" value="#111111" />
                    <div>
                      <p class="text-sm font-semibold text-neutral-900">Цвет</p>
                    </div>
                  </div>
                </div>

                <div>
                  <p class="admin-card-field-label">Рамки</p>
                  <div id="admin-card-frame-options" class="admin-card-style-grid is-compact mt-3">
                    <% avatarFrames.forEach((item) => { %>
                      <%- renderFrameButton(item) %>
                    <% }) %>
                  </div>
                </div>

                <div>
                  <p class="admin-card-field-label">Фоновый emoji</p>
                  <div id="admin-card-emoji-background-options" class="admin-card-style-grid is-compact mt-3">
                    <% emojiBackgroundPacks.forEach((item) => { %>
                      <%- renderEmojiPackButton(item) %>
                    <% }) %>
                  </div>
                </div>

                <label class="admin-card-switch">
                  <span class="admin-card-switch-copy">
                    <strong>Скрыть брендинг UNQX</strong>
                  </span>
                  <span class="admin-card-switch-ui">
                    <input id="admin-card-hide-branding" type="checkbox" />
                    <span class="track"></span>
                    <span class="thumb"></span>
                  </span>
                </label>

                <div class="admin-card-save-row">
                  <p id="admin-card-save-status" class="admin-card-save-status"></p>
                  <button type="submit" id="save-card-btn" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-neutral-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">
                    Сохранить визитку
                  </button>
                </div>
              </div>
            </section>

            <section class="admin-card-panel hidden" data-card-panel="pets">
              <div class="admin-card-panel-head">
                <h3>Животные</h3>
                <p>Ручная выдача, имя и видимость питомцев на визитке.</p>
              </div>

              <div id="admin-card-pets-list" class="admin-card-editor-stack"></div>
            </section>
          </div>

          <aside class="admin-card-preview-column">
            <div class="admin-card-preview-shell">
              <div class="admin-card-preview-head">
                <div class="min-w-0">
                  <p class="admin-card-preview-eyebrow">Предпросмотр</p>
                  <p id="admin-card-preview-slug-label" class="admin-card-preview-slug">unqx.uz/[slug]</p>
                </div>
                <a
                  id="admin-card-preview-open-link"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-neutral-700 hover:underline"
                >
                  Открыть
                </a>
              </div>
              <div class="admin-card-preview-body">
                <div id="profile-card-live-preview" class="rounded-2xl border border-neutral-200 bg-white p-4"></div>
              </div>
            </div>
          </aside>
        </div>
      </form>
    <% } %>
  </div>
  <%- include('../partials/admin-layout-end') %>

  <script nonce="<%= cspNonce %>" id="admin-card-editor-presets" type="application/json"><%- JSON.stringify({
    signatureThemes,
    colorThemes,
    avatarFrames,
    emojiBackgroundPacks,
  }) %></script>
  <script nonce="<%= cspNonce %>" src="/js/admin-layout.js"></script>
  <script nonce="<%= cspNonce %>" src="/vendor/cropperjs/cropper.min.js"></script>
  <script nonce="<%= cspNonce %>" src="/vendor/sortablejs/Sortable.min.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/card-view.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/admin-card-editor.js"></script>
</body>
</html>
