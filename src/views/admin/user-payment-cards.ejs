<% const pageTitle=typeof title==="string" && title ? title : "Payment карточки" ; const pageUserId=typeof
    userId==="string" ? userId : "" ; const dashboardBasePath=adminSession?.role==="manager" ? "/manager/dashboard"
    : "/admin/dashboard" ; const cardBasePath=adminSession?.role==="manager" ? "/manager/users" : "/admin/users" ; %>
    <!doctype html>
    <html lang="ru">

    <head>
        <%- include('../partials/head', { title: pageTitle, styles: ['/css/admin.css'] }) %>
    </head>

    <body class="antialiased" data-admin-layout="1" data-page="admin-user-payment-cards"
        data-user-id="<%= pageUserId %>" data-admin-role="<%= adminSession?.role || 'admin' %>"
        data-card-base-path="<%= cardBasePath %>">
        <%- include('../partials/admin-layout-start', { activeTab: 'users' , dashboardBasePath }) %>
            <div class="mx-auto w-full max-w-6xl space-y-4">
                <div class="border-b border-neutral-200 pb-4">
                    <h1 id="pc-title" class="text-2xl font-black">Payment карточки</h1>
                    <p id="pc-subtitle" class="mt-1 text-sm text-neutral-500">Загрузка данных...</p>
                    <a id="pc-back-link" href="#" class="mt-1 inline-block text-sm text-blue-600 hover:underline">←
                        Визитка пользователя</a>
                </div>

                <div id="pc-error"
                    class="hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                <!-- Card list -->
                <section id="pc-list-section" class="rounded-2xl border border-neutral-200 bg-white p-4">
                    <div class="flex items-center justify-between gap-4">
                        <h2 class="text-lg font-bold">Все Payment карточки</h2>
                        <button id="pc-create-btn" type="button"
                            class="rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">+
                            Создать</button>
                    </div>
                    <div id="pc-list" class="mt-4 space-y-2">
                        <p class="text-sm text-neutral-500">Загрузка...</p>
                    </div>
                </section>

                <!-- Editor form (hidden initially) -->
                <section id="pc-editor" class="hidden space-y-5">
                    <div class="flex items-center justify-between gap-4">
                        <h2 id="pc-editor-title" class="text-lg font-bold">Новая Payment карточка</h2>
                        <button id="pc-editor-cancel" type="button"
                            class="rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold transition hover:bg-neutral-100">Отмена</button>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <h3 class="text-base font-bold">Номер страницы</h3>
                        <p class="mt-1 text-xs text-neutral-500">URL: /payment/<span id="pc-number-preview">0</span></p>
                        <input id="pc-number" type="number" min="0" step="1" placeholder="0"
                            class="mt-2 w-40 rounded-xl border border-neutral-300 px-3 py-2 text-sm" />
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <h3 class="text-base font-bold">Аватар</h3>
                        <div class="mt-4 flex flex-wrap items-center gap-4">
                            <div
                                class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-full border border-neutral-200 bg-neutral-100">
                                <img id="pc-avatar-preview" src="" alt="avatar"
                                    class="hidden h-full w-full object-cover" />
                                <span id="pc-avatar-fallback" class="text-xs font-semibold text-neutral-500">Нет</span>
                            </div>
                            <div class="space-y-2">
                                <input id="pc-avatar-file" type="file" accept="image/png,image/jpeg,image/webp"
                                    class="text-sm" />
                                <div class="flex flex-wrap gap-2">
                                    <button id="pc-avatar-upload" type="button"
                                        class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold transition hover:bg-neutral-100">Загрузить</button>
                                    <button id="pc-avatar-remove" type="button"
                                        class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Удалить</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <h3 class="text-base font-bold">Основные данные</h3>
                        <div class="mt-4 grid gap-3 md:grid-cols-2">
                            <label class="text-sm font-medium text-neutral-700">
                                Имя <span class="text-red-500">*</span>
                                <input id="pc-name" type="text" maxlength="120"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" required />
                            </label>
                            <label class="text-sm font-medium text-neutral-700">
                                Должность
                                <input id="pc-role" type="text" maxlength="120"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                            <label class="text-sm font-medium text-neutral-700 md:col-span-2">
                                Био
                                <textarea id="pc-bio" rows="2" maxlength="120"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2"></textarea>
                            </label>
                            <label class="text-sm font-medium text-neutral-700">
                                Хэштег
                                <input id="pc-hashtag" type="text" maxlength="50"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <h3 class="text-base font-bold">Контакты</h3>
                        <div class="mt-4 grid gap-3 md:grid-cols-2">
                            <label class="text-sm font-medium text-neutral-700">
                                Адрес
                                <input id="pc-address" type="text"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                            <label class="text-sm font-medium text-neutral-700">
                                Индекс
                                <input id="pc-postcode" type="text" maxlength="20"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                            <label class="text-sm font-medium text-neutral-700">
                                Email
                                <input id="pc-email" type="email" maxlength="100"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                            <label class="text-sm font-medium text-neutral-700">
                                Доп. телефон
                                <input id="pc-extra-phone" type="text" maxlength="30"
                                    class="mt-1 w-full rounded-xl border border-neutral-300 px-3 py-2" />
                            </label>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <div class="flex items-center justify-between gap-4">
                            <h3 class="text-base font-bold">Теги</h3>
                            <p class="text-xs text-neutral-500">Лимит: 5</p>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <input id="pc-tag-input" type="text"
                                class="flex-1 rounded-xl border border-neutral-300 px-3 py-2 text-sm"
                                placeholder="#Дизайнер" />
                            <button id="pc-tag-add" type="button"
                                class="rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold transition hover:bg-neutral-100">Добавить</button>
                        </div>
                        <div id="pc-tags-list" class="mt-3 flex flex-wrap gap-2"></div>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <div class="flex items-center justify-between gap-4">
                            <h3 class="text-base font-bold">Кнопки</h3>
                            <p class="text-xs text-neutral-500">Лимит: 6</p>
                        </div>
                        <div class="mt-3">
                            <button id="pc-button-add" type="button"
                                class="rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold transition hover:bg-neutral-100">Добавить
                                кнопку</button>
                        </div>
                        <div id="pc-buttons-list" class="mt-4 space-y-2"></div>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4">
                        <h3 class="text-base font-bold">Оформление</h3>
                        <p class="mt-2 text-sm text-neutral-500">Тема: <span
                                class="font-semibold text-neutral-900">Carrara Prestige</span> (зафиксирована)</p>
                    </div>

                    <div class="flex items-center justify-end gap-3">
                        <button id="pc-delete-btn" type="button"
                            class="hidden rounded-xl border border-red-200 px-5 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-50">Удалить</button>
                        <button id="pc-save" type="button"
                            class="rounded-xl bg-neutral-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800">Сохранить</button>
                    </div>
                </section>
            </div>
            <%- include('../partials/admin-layout-end') %>
                <script nonce="<%= cspNonce %>" src="/js/admin-layout.js"></script>
                <script nonce="<%= cspNonce %>" src="/js/admin-dialogs.js"></script>
                <script nonce="<%= cspNonce %>" src="/js/admin-user-payment-cards.js"></script>
    </body>

    </html>