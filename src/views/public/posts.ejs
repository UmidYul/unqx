<% const pageTitle=typeof title==="string" && title ? title : "Посты | UNQX"; const pageDescription=typeof description==="string" && description ? description : "Все опубликованные посты пользователей UNQX."; const pageBaseUrl=typeof baseUrl==="string" && baseUrl ? baseUrl : ""; const pageCanonicalUrl=typeof canonicalUrl==="string" && canonicalUrl ? canonicalUrl : `${pageBaseUrl}/posts`; const pageUserSession=typeof userSession !=="undefined" ? userSession : null; const hasAuthSession=Boolean(pageUserSession && pageUserSession.userId); const authPhotoUrlFromServer=typeof authPhotoUrl==="string" && authPhotoUrl.trim() ? authPhotoUrl.trim() : ""; const authNavPhotoUrl=authPhotoUrlFromServer || (hasAuthSession && pageUserSession.avatarUrl ? pageUserSession.avatarUrl : "/brand/profile-user.svg"); const postsList=Array.isArray(posts) ? posts : []; const p=pagination && typeof pagination==="object" ? pagination : { page: 1, totalPages: 1, total: postsList.length }; const trimMetricDecimal=(value)=>String(value).replace(/\.0$/, ""); const formatHomePostMetric=(value)=>{ const amount=Math.max(0, Number(value || 0)); if (!Number.isFinite(amount)) return "0"; if (amount >= 1000000) return `${trimMetricDecimal((amount / 1000000).toFixed(amount >= 10000000 ? 0 : 1))}M`; if (amount >= 1000) return `${trimMetricDecimal((amount / 1000).toFixed(amount >= 10000 ? 0 : 1))}K`; return amount.toLocaleString("ru-RU"); }; const formatHomePostDateTime=(value)=>{ const date=new Date(value); if (Number.isNaN(date.getTime())) return "только что"; const diffMs=Math.max(0, Date.now() - date.getTime()); const plural=(amount, one, few, many)=>{ const mod10=amount % 10; const mod100=amount % 100; if (mod10 === 1 && mod100 !== 11) return one; if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few; return many; }; const units=[{ ms: 30 * 24 * 60 * 60 * 1000, forms: ["месяц", "месяца", "месяцев"] }, { ms: 7 * 24 * 60 * 60 * 1000, forms: ["неделю", "недели", "недель"] }, { ms: 24 * 60 * 60 * 1000, forms: ["день", "дня", "дней"] }, { ms: 60 * 60 * 1000, forms: ["час", "часа", "часов"] }, { ms: 60 * 1000, forms: ["минуту", "минуты", "минут"] }, { ms: 1000, forms: ["секунду", "секунды", "секунд"] }]; for (const unit of units) { if (diffMs >= unit.ms) { const amount=Math.max(1, Math.floor(diffMs / unit.ms)); return `${amount} ${plural(amount, ...unit.forms)} назад`; } } return "только что"; }; const formatHomePostHandle=(author)=>{ const raw=String(author && typeof author==="object" ? (author.handle || author.name || author.primarySlug || "unqx") : "unqx").trim(); const compact=raw.replace(/\s+/g, ""); if (!compact) return "@unqx"; return compact.startsWith("@") ? compact : `@${compact}`; }; const buildHomeCommentsHref=(href, postId)=>{ const normalizedHref=String(href || "").trim() || "/"; const normalizedPostId=String(postId || "").trim(); if (!normalizedPostId) return normalizedHref; try { const baseUrlForResolve=pageBaseUrl || pageCanonicalUrl || "https://unqx.uz"; const url=new URL(normalizedHref, baseUrlForResolve); url.searchParams.set("comments", "1"); url.hash=`wall-post-${encodeURIComponent(normalizedPostId)}`; const isAbsoluteHref=/^[a-zA-Z][a-zA-Z\d+.-]*:/.test(normalizedHref); return isAbsoluteHref ? url.toString() : `${url.pathname}${url.search}${url.hash}`; } catch { const hashIndex=normalizedHref.indexOf("#"); const base=hashIndex >= 0 ? normalizedHref.slice(0, hashIndex) : normalizedHref; const hash=hashIndex >= 0 ? normalizedHref.slice(hashIndex) : `#wall-post-${encodeURIComponent(normalizedPostId)}`; const separator=base.includes("?") ? "&" : "?"; return `${base}${separator}comments=1${hash}`; } }; %>
<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', { title: pageTitle, description: pageDescription, styles: ['/css/public-card.css'], image: typeof image==='string' ? image : undefined, ogType: 'website' }) %>
</head>

<body class="antialiased" style="background-color: #FAFAFA;">
  <main class="public-posts-page relative min-h-screen overflow-hidden" data-page="public-home" style="background-color: #FAFAFA;">
    <div class="relative z-10">
      <nav class="site-header fixed left-0 right-0 top-0 z-50 border-b border-neutral-200 bg-white/80 backdrop-blur-md">
        <div class="site-header-inner mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
          <a href="/" class="site-logo inline-flex items-center gap-2 text-xl font-black tracking-tight text-neutral-900">
            <img src="/brand/logo.PNG" alt="UNQX" class="site-logo-mark h-8 w-8 rounded-md border border-neutral-200 object-cover" />
            <span class="site-logo-name">UNQX</span>
          </a>
          <div class="site-header-links hidden items-center gap-8 md:flex">
            <a href="/directory" class="site-header-link text-sm text-neutral-500 transition-colors hover:text-neutral-900">Резиденты</a>
            <% if (leaderboardEnabled) { %><a href="/leaderboard" class="site-header-link whitespace-nowrap text-sm text-neutral-500 transition-colors hover:text-neutral-900">UNQ&nbsp;ELITE</a><% } %>
            <a href="/unix-leaders" class="site-header-link whitespace-nowrap text-sm text-neutral-500 transition-colors hover:text-neutral-900">Unix&nbsp;Leaders</a>
            <a href="/posts" class="site-header-link text-sm font-semibold text-neutral-900">Посты</a>
            <div id="home-auth-nav-desktop" class="flex items-center gap-2">
              <a href="/login" data-auth-login class="site-header-login interactive-btn inline-flex min-h-11 items-center justify-center rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:bg-neutral-100 <%= hasAuthSession ? 'hidden' : '' %>">Войти</a>
              <a href="/profile" data-auth-profile class="site-header-profile <%= hasAuthSession ? 'inline-flex' : 'hidden' %> h-9 w-9 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition hover:bg-neutral-100" aria-label="Мой профиль">
                <img data-auth-avatar src="<%= authNavPhotoUrl %>" alt="avatar" class="h-7 w-7 rounded-full border border-neutral-200 bg-white object-cover" />
              </a>
            </div>
          </div>
          <button type="button" class="site-header-mobile-toggle text-neutral-900 md:hidden" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню">
            <svg data-menu-open-icon class="icon-stroke h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
            <svg data-menu-close-icon class="icon-stroke hidden h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <div id="mobile-menu" class="site-mobile-menu hidden border-t border-neutral-200 bg-white px-6 pb-6 pt-4 md:hidden" data-mobile-menu>
          <div class="flex flex-col gap-4">
            <a href="/directory" class="site-mobile-link text-sm text-neutral-500">Резиденты</a>
            <% if (leaderboardEnabled) { %><a href="/leaderboard" class="site-mobile-link whitespace-nowrap text-sm text-neutral-500">UNQ&nbsp;ELITE</a><% } %>
            <a href="/unix-leaders" class="site-mobile-link whitespace-nowrap text-sm text-neutral-500">Unix&nbsp;Leaders</a>
            <a href="/posts" class="site-mobile-link text-sm font-semibold text-neutral-900">Посты</a>
            <div id="home-auth-nav-mobile" class="flex w-full items-center justify-center gap-2">
              <a href="/login" data-auth-login class="site-header-login inline-flex min-h-11 items-center justify-center rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:bg-neutral-100 <%= hasAuthSession ? 'hidden' : '' %>">Войти</a>
              <a href="/profile" data-auth-profile class="site-header-profile <%= hasAuthSession ? 'inline-flex' : 'hidden' %> h-9 w-9 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 transition hover:bg-neutral-100" aria-label="Мой профиль">
                <img data-auth-avatar src="<%= authNavPhotoUrl %>" alt="avatar" class="h-7 w-7 rounded-full border border-neutral-200 bg-white object-cover" />
              </a>
            </div>
          </div>
        </div>
      </nav>

      <section class="px-6 pb-12 pt-40 md:pt-44">
        <div class="mx-auto max-w-6xl">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">POSTS</p>
          <div class="mt-3 mb-10 flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-4xl font-black tracking-tight text-neutral-900 md:text-6xl">Посты</h1>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-600">Все опубликованные посты пользователей UNQX в одной ленте.</p>
            </div>
            <span class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold text-neutral-600"><%= Number(p.total || postsList.length || 0).toLocaleString("ru-RU") %> постов</span>
          </div>

          <% if (!postsList.length) { %>
            <div class="mt-10 rounded-2xl border border-neutral-200 bg-white p-8 text-center text-sm text-neutral-500">Пока нет опубликованных постов для отображения.</div>
          <% } else { %>
            <div class="home-latest-post-stack public-posts-grid mt-10">
              <% postsList.forEach((post)=> { const author=post && post.author && typeof post.author==="object" ? post.author : {}; const followState=post && post.viewerFollowState && typeof post.viewerFollowState==="object" ? post.viewerFollowState : {}; const postHref=String(post && post.postHref || author.profileHref || "/").trim() || "/"; const commentsHref=buildHomeCommentsHref(postHref, post && post.id); const postSlug=String(author.primarySlug || "").trim(); const loginNext=postHref || author.profileHref || "/"; const likedNow=Boolean(post && post.viewerHasLiked); %>
                <article class="home-latest-post-card rounded-[1.7rem] border border-neutral-200 bg-white p-5" data-home-post-card data-post-href="<%= postHref %>" tabindex="0" role="link" aria-label="Открыть пост <%= formatHomePostHandle(author) %>">
                  <img src="/brand/unqlogo.png" alt="" class="home-latest-post-brand" aria-hidden="true" loading="lazy" />
                  <div class="home-latest-post-head">
                    <a href="<%= author.profileHref || postHref || '#' %>" class="home-latest-post-author">
                      <% if (author.avatarUrl) { %><img src="<%= author.avatarUrl %>" alt="<%= author.name || 'UNQX User' %>" class="h-12 w-12 shrink-0 rounded-full border border-neutral-200 object-cover" loading="lazy" /><% } else { %><span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-neutral-100 text-sm font-semibold text-neutral-600"><%= String(author.name || "UN").split(" ").map((part) => part[0]).join("").slice(0, 2).toUpperCase() %></span><% } %>
                      <span class="home-latest-post-author-meta">
                        <span class="home-latest-post-author-line"><span class="home-latest-post-author-name"><%= formatHomePostHandle(author) %></span><% if (author.verified) { %><span class="home-latest-post-author-verified" aria-label="Верифицированный аккаунт"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.2 1.8 2.8-.3 1.2 2.5 2.5 1.2-.3 2.8L21.5 12l-1.8 2.2.3 2.8-2.5 1.2-1.2 2.5-2.8-.3L12 21.5l-2.2-1.8-2.8.3-1.2-2.5-2.5-1.2.3-2.8L2.5 12l1.8-2.2-.3-2.8 2.5-1.2 1.2-2.5 2.8.3L12 2.5Zm-1.1 13.1 5-5-1.1-1.1-3.9 3.9-1.8-1.8-1.1 1.1 2.9 2.9Z"></path></svg></span><% } %></span>
                        <span class="home-latest-post-author-slug">unqx.uz/<%= author.primarySlug || "UNQ" %></span>
                      </span>
                    </a>
                    <% if (followState.canFollow) { %><button type="button" data-home-follow-button data-follow-slug="<%= author.primarySlug || '' %>" data-following="<%= followState.isFollowing ? 'true' : 'false' %>" data-login-next="<%= loginNext %>" aria-label="<%= followState.isFollowing ? 'Отписаться' : 'Подписаться' %>" title="<%= followState.isFollowing ? 'Отписаться' : 'Подписаться' %>" class="interactive-btn home-post-follow-btn <%= followState.isFollowing ? 'is-following' : '' %>"><span class="home-post-follow-btn-symbol" aria-hidden="true">+</span></button><% } %>
                  </div>
                  <p class="home-latest-post-content"><%= post.content %></p>
                  <div class="home-latest-post-foot">
                    <div class="home-latest-post-actions" aria-label="Статистика поста">
                      <button type="button" class="home-latest-post-action-group home-latest-post-action-button <%= likedNow ? 'is-liked' : '' %>" data-home-post-like data-post-id="<%= post.id || '' %>" data-post-slug="<%= postSlug %>" data-post-href="<%= postHref %>" data-likes-count="<%= Math.max(0, Number(post.likesCount || 0)) %>" data-liked="<%= likedNow ? 'true' : 'false' %>" data-login-next="<%= loginNext %>" aria-label="<%= likedNow ? 'Убрать лайк' : 'Поставить лайк' %>" aria-pressed="<%= likedNow ? 'true' : 'false' %>" <%= post.id && postSlug ? '' : 'disabled' %>><svg class="home-latest-post-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.75 4.9 13.86a5.56 5.56 0 0 1 0-7.94 5.39 5.39 0 0 1 7.67 0L12 6.49l.57-.57a5.39 5.39 0 0 1 7.67 0 5.56 5.56 0 0 1 0 7.94L12 20.75Z"></path></svg><span class="home-latest-post-action-value" data-home-post-like-count><%= Number(post.likesCount || 0) > 0 ? formatHomePostMetric(post.likesCount) : '' %></span></button>
                      <button type="button" class="home-latest-post-action-group home-latest-post-action-button" data-home-post-comment data-post-comments-href="<%= commentsHref %>" aria-label="Открыть комментарии"><svg class="home-latest-post-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5A8.7 8.7 0 0 1 8 18.7L3 20.5l1.8-4.8A8.7 8.7 0 0 1 4 11.5a8.5 8.5 0 1 1 17 0Z"></path></svg><span class="home-latest-post-action-value"><%= Number(post.commentsCount || 0) > 0 ? formatHomePostMetric(post.commentsCount) : '' %></span></button>
                      <button type="button" class="home-latest-post-action-group home-latest-post-action-group--link home-latest-post-action-button" data-home-post-share data-post-href="<%= postHref %>" aria-label="Поделиться постом"><svg class="home-latest-post-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"></path><path d="M22 2 15 22l-4-9-9-4 20-7Z"></path></svg></button>
                    </div>
                    <span class="home-latest-post-date"><%= formatHomePostDateTime(post.createdAt) %></span>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>

          <% if (Number(p.total || postsList.length || 0) > 0) { %>
            <nav class="public-posts-pagination" aria-label="Пагинация постов">
              <span class="public-posts-pagination-total">Найдено: <%= Number(p.total || postsList.length || 0).toLocaleString("ru-RU") %></span>
              <span class="public-posts-pagination-actions">
                <% if (Number(p.page || 1) > 1) { %><a class="public-posts-pagination-button" href="/posts?page=<%= Number(p.page || 1) - 1 %>">Назад</a><% } %>
                <span class="public-posts-pagination-current"><%= Number(p.page || 1) %>/<%= Number(p.totalPages || 1) %></span>
                <% if (Number(p.page || 1) < Number(p.totalPages || 1)) { %><a class="public-posts-pagination-button" href="/posts?page=<%= Number(p.page || 1) + 1 %>">Вперёд</a><% } %>
              </span>
            </nav>
          <% } %>
        </div>
      </section>

      <%- include('../partials/order-modal') %>
    </div>
  </main>
  <script nonce="<%= cspNonce %>" src="/js/site-dialogs.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/order-modal.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
  <script nonce="<%= cspNonce %>" src="/vendor/html2canvas/html2canvas.min.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/public-home-search.js"></script>
</body>

</html>
