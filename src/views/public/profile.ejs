          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Текущий
            пароль</label>
          <input id="profile-password-current" type="password" autocomplete="current-password"
            class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Новый
            пароль</label>
          <input id="profile-password-new" type="password" autocomplete="new-password"
            class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Повторите
            пароль</label>
          <input id="profile-password-confirm" type="password" autocomplete="new-password"
            class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <p id="profile-password-modal-error" class="hidden text-xs text-red-700"></p>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <button id="profile-password-modal-submit" type="button"
            class="interactive-btn min-h-11 rounded-lg bg-neutral-900 px-3 py-2 text-sm font-semibold text-white sm:min-w-[140px]">Сохранить</button>
          <button id="profile-password-modal-close" type="button"
            class="interactive-btn min-h-11 rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold sm:min-w-[120px]">Отмена</button>
        </div>
      </div>
    </div>
  </div>

  <div id="profile-private-password-add-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div id="profile-private-password-add-dialog" class="w-full max-w-md rounded-2xl bg-white p-5" role="dialog"
      aria-modal="true" aria-labelledby="profile-private-password-add-title" tabindex="-1">
      <button id="profile-private-password-add-close-top" type="button"
        class="interactive-btn ml-auto inline-flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-300 text-neutral-600"
        aria-label="Закрыть окно">
        <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <h3 id="profile-private-password-add-title" class="text-lg font-bold text-neutral-900">Добавить пароль</h3>
      <p class="mt-1 text-xs text-neutral-500">Пароль открывает приватную визитку на 5 минут.</p>
      <div class="mt-3 grid gap-3">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Метка
            (необязательно)</label>
          <input id="profile-private-password-add-label" type="text" maxlength="80" placeholder="Например: Партнёр"
            class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Новый
            пароль</label>
          <input id="profile-private-password-add-value" type="password" minlength="4" maxlength="128"
            placeholder="Минимум 4 символа" class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <p id="profile-private-password-add-error" class="hidden text-xs text-red-700"></p>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <button id="profile-private-password-add-submit" type="button"
            class="interactive-btn min-h-11 rounded-lg bg-neutral-900 px-3 py-2 text-sm font-semibold text-white sm:min-w-[140px]">Добавить</button>
          <button id="profile-private-password-add-cancel" type="button"
            class="interactive-btn min-h-11 rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold sm:min-w-[120px]">Отмена</button>
        </div>
      </div>
    </div>
  </div>

  <div id="profile-private-password-change-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div id="profile-private-password-change-dialog" class="w-full max-w-md rounded-2xl bg-white p-5" role="dialog"
      aria-modal="true" aria-labelledby="profile-private-password-change-title" tabindex="-1">
      <button id="profile-private-password-change-close-top" type="button"
        class="interactive-btn ml-auto inline-flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-300 text-neutral-600"
        aria-label="Закрыть окно">
        <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <h3 id="profile-private-password-change-title" class="text-lg font-bold text-neutral-900">Сменить пароль</h3>
      <p id="profile-private-password-change-meta" class="mt-1 text-xs text-neutral-500"></p>
      <div class="mt-3 grid gap-3">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Текущий
            пароль</label>
          <input id="profile-private-password-change-old" type="password" maxlength="128"
            class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500">Новый
            пароль</label>
          <input id="profile-private-password-change-new" type="password" minlength="4" maxlength="128"
            placeholder="Минимум 4 символа" class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
        </div>
        <p id="profile-private-password-change-error" class="hidden text-xs text-red-700"></p>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <button id="profile-private-password-change-submit" type="button"
            class="interactive-btn min-h-11 rounded-lg bg-neutral-900 px-3 py-2 text-sm font-semibold text-white sm:min-w-[140px]">Сохранить</button>
          <button id="profile-private-password-change-cancel" type="button"
            class="interactive-btn min-h-11 rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold sm:min-w-[120px]">Отмена</button>
        </div>
      </div>
    </div>
  </div>

  <div id="profile-verification-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white p-5">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-lg font-bold text-neutral-900">Заявка на верификацию</h3>
        <button id="profile-verification-close" type="button"
          class="interactive-btn inline-flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-300"
          aria-label="Закрыть">
          <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="grid gap-2">
        <input id="profile-verification-company" type="text" placeholder="Компания"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
        <input id="profile-verification-role" type="text" placeholder="Роль"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
        <select id="profile-verification-sector" class="rounded-lg border border-neutral-200 px-3 py-2 text-sm">
          <option value="design">Сфера: Дизайн</option>
          <option value="sales">Сфера: Продажи</option>
          <option value="marketing">Сфера: Маркетинг</option>
          <option value="it">Сфера: IT</option>
          <option value="other" selected>Сфера: Другое</option>
        </select>
        <select id="profile-verification-proof-type" class="rounded-lg border border-neutral-200 px-3 py-2 text-sm">
          <option value="email">Email</option>
          <option value="linkedin">LinkedIn</option>
          <option value="website">Website</option>
        </select>
        <input id="profile-verification-proof-value" type="text" placeholder="Ссылка или контакт"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
        <textarea id="profile-verification-comment" rows="3" placeholder="Комментарий (необязательно)"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm"></textarea>
      </div>
      <div class="mt-3">
        <button id="profile-verification-submit" type="button"
          class="interactive-btn min-h-11 rounded-lg bg-neutral-900 px-3 py-2 text-sm font-semibold text-white">Отправить
          заявку</button>
      </div>
    </div>
  </div>

  <div id="profile-badge-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white p-5">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-lg font-bold text-neutral-900">Заявка на бейдж</h3>
        <button id="profile-badge-close" type="button"
          class="interactive-btn inline-flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-300"
          aria-label="Закрыть">
          <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="grid gap-2">
        <select id="profile-badge-type" class="rounded-lg border border-neutral-200 px-3 py-2 text-sm">
          <option value="government">Гос. служебный профиль</option>
          <option value="unqx_staff">Работник UNQX</option>
        </select>
        <input id="profile-badge-workplace" type="text" placeholder="Место работы / организация" maxlength="200"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
        <input id="profile-badge-role" type="text" placeholder="Должность" maxlength="160"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
        <textarea id="profile-badge-proof-text" rows="3" placeholder="Описание / доказательство" maxlength="2000"
          class="rounded-lg border border-neutral-200 px-3 py-2 text-sm"></textarea>
        <input id="profile-badge-proof-link" type="url" placeholder="Ссылка на подтверждение (необязательно)"
          maxlength="500" class="rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
      </div>
      <div class="mt-3">
        <button id="profile-badge-submit" type="button"
          class="interactive-btn min-h-11 rounded-lg bg-neutral-900 px-3 py-2 text-sm font-semibold text-white">Отправить
          заявку</button>
      </div>
    </div>
  </div>

  <%- include('../partials/order-modal') %>

    <script nonce="<%= cspNonce %>" src="/vendor/sortablejs/Sortable.min.js"></script>
    <script nonce="<%= cspNonce %>" src="/vendor/cropperjs/cropper.min.js"></script>
    <script nonce="<%= cspNonce %>" src="/vendor/chartjs/chart.umd.min.js"></script>
    <script nonce="<%= cspNonce %>" src="/vendor/qrcode/qrcode.min.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/site-dialogs.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/official-unq-letters.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/order-modal.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
    <script nonce="<%= cspNonce %>" src="/js/card-view.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
    <script nonce="<%= cspNonce %>" src="/js/profile.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
</body>

</html>
