<%
  const pagePaymentCard = typeof paymentCard === "object" && paymentCard ? paymentCard : {};
  const pageProfile = pagePaymentCard.profile && typeof pagePaymentCard.profile === "object" ? pagePaymentCard.profile : {};
  const pageMethods = Array.isArray(pagePaymentCard.methods) ? pagePaymentCard.methods : [];
  const pageTags = Array.isArray(pageProfile.tags) ? pageProfile.tags : [];
  const pageTheme = pageProfile.theme || "default_dark";
  const pageTitle = typeof title === "string" && title ? title : "Payment";
  const pageDescription = typeof description === "string" ? description : "";
  const pageImage = typeof image === "string" ? image : "";
%>
<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', {
    title: pageTitle,
    description: pageDescription,
    image: pageImage,
    styles: ['/css/public-card.css'],
    noindex: typeof noindex === 'boolean' ? noindex : false
  }) %>
</head>

<body class="antialiased bg-neutral-950 text-white" data-card-theme="<%= pageTheme %>">
  <main class="min-h-screen px-4 py-5 sm:px-6 sm:py-8">
    <div class="mx-auto flex min-h-[calc(100vh-2.5rem)] w-full max-w-3xl flex-col">
      <header class="flex items-center justify-between gap-3">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-white/75 transition hover:text-white">
          <img src="/brand/logo.PNG" alt="" class="h-8 w-8 rounded-lg bg-white object-contain p-1" />
          <span>UNQX Payment</span>
        </a>
        <span class="rounded-full border border-white/15 px-3 py-1 text-xs font-semibold text-white/60">/payment/<%= pagePaymentCard.publicSlug %></span>
      </header>

      <section class="grid flex-1 items-center gap-5 py-8 md:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-4">
          <div class="h-24 w-24 overflow-hidden rounded-[28px] border border-white/15 bg-white/10">
            <% if (pageProfile.avatarUrl) { %>
              <img src="<%= pageProfile.avatarUrl %>" alt="" class="h-full w-full object-cover" />
            <% } else { %>
              <div class="flex h-full w-full items-center justify-center text-lg font-black text-white/55">UNQ</div>
            <% } %>
          </div>
          <div>
            <p class="text-sm font-semibold text-white/60"><%= pagePaymentCard.title || 'Payment' %></p>
            <h1 class="mt-2 text-4xl font-black leading-tight tracking-normal text-white sm:text-5xl"><%= pageProfile.name || 'UNQX User' %></h1>
            <% if (pageProfile.role) { %>
              <p class="mt-2 text-base font-medium text-white/70"><%= pageProfile.role %></p>
            <% } %>
            <% if (pageProfile.bio) { %>
              <p class="mt-4 max-w-md text-sm leading-6 text-white/62"><%= pageProfile.bio %></p>
            <% } %>
          </div>
          <% if (pageTags.length) { %>
            <div class="flex flex-wrap gap-2">
              <% pageTags.slice(0, 8).forEach((tag) => { %>
                <span class="rounded-full border border-white/15 bg-white/[0.07] px-3 py-1 text-xs font-semibold text-white/70"><%= tag %></span>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="space-y-3 rounded-[28px] border border-white/12 bg-white/[0.06] p-4 shadow-2xl shadow-black/20 backdrop-blur md:p-5">
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <p class="text-xs uppercase tracking-[0.16em] text-white/45">Точка</p>
            <h2 class="mt-1 text-xl font-bold text-white"><%= pagePaymentCard.title || 'Payment' %></h2>
            <% if (pagePaymentCard.address || pagePaymentCard.postcode) { %>
              <p class="mt-2 text-sm leading-6 text-white/65">
                <%= pagePaymentCard.address || '' %><%= pagePaymentCard.address && pagePaymentCard.postcode ? ', ' : '' %><%= pagePaymentCard.postcode || '' %>
              </p>
            <% } %>
          </div>

          <div class="space-y-2">
            <% if (pageMethods.length) { %>
              <% pageMethods.forEach((method) => { %>
                <article class="rounded-2xl border border-white/10 bg-white/[0.08] p-4">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-sm font-bold text-white"><%= method.label %></p>
                      <% if (method.value) { %>
                        <p class="mt-2 break-words font-mono text-sm text-white/78"><%= method.value %></p>
                      <% } %>
                    </div>
                    <span class="shrink-0 rounded-full border border-white/12 px-2 py-1 text-[11px] font-semibold uppercase text-white/50"><%= method.type || 'other' %></span>
                  </div>
                  <% if (method.note) { %>
                    <p class="mt-3 text-sm leading-6 text-white/58"><%= method.note %></p>
                  <% } %>
                </article>
              <% }) %>
            <% } else { %>
              <div class="rounded-2xl border border-white/10 bg-white/[0.08] p-6 text-center text-sm text-white/55">
                Реквизиты скоро появятся.
              </div>
            <% } %>
          </div>

          <div class="grid gap-2 sm:grid-cols-2">
            <% if (pageProfile.email) { %>
              <a href="mailto:<%= pageProfile.email %>" class="rounded-2xl border border-white/10 bg-white/[0.08] px-4 py-3 text-sm font-semibold text-white/75 transition hover:bg-white/[0.12]">Email</a>
            <% } %>
            <% if (pageProfile.extraPhone) { %>
              <a href="tel:<%= pageProfile.extraPhone.replace(/\s+/g, '') %>" class="rounded-2xl border border-white/10 bg-white/[0.08] px-4 py-3 text-sm font-semibold text-white/75 transition hover:bg-white/[0.12]">Телефон</a>
            <% } %>
          </div>
        </div>
      </section>
    </div>
  </main>
</body>

</html>
