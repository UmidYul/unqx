<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', { title: title || "Регистрация | UNQX" , description: typeof description==='string' ?
    description : undefined, noindex: true }) %>
</head>

<body class="antialiased bg-neutral-50">
  <main class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-10">
    <form id="register-form" class="w-full rounded-2xl border border-neutral-200 bg-white p-5">
      <a href="/"
        class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-2.5 py-1.5 text-sm font-semibold text-neutral-700">
        <img src="/brand/logo.PNG" alt="UNQX" class="h-6 w-6 rounded-md border border-neutral-200 object-cover" />
        <span>UNQX</span>
      </a>
      <h1 class="mt-4 text-2xl font-bold text-neutral-900">Регистрация</h1>
      <p class="mt-1 text-sm text-neutral-500">Создай аккаунт UNQX</p>

      <label class="mt-4 block text-sm font-medium text-neutral-700">Имя
        <input id="firstName" type="text" autocomplete="given-name" placeholder="Как тебя зовут?"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Город
        <select id="city" autocomplete="address-level2"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required>
          <option value="" selected disabled>Выберите город</option>
          <%- include('../partials/city-options') %>
        </select>
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Тип профиля
        <select id="profileType" class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required>
          <option value="person" selected>Личность</option>
          <option value="company">Компания</option>
        </select>
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Логин
        <input id="login" type="text" autocomplete="username"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Email для восстановления (опционально)
        <input id="email" type="email" autocomplete="email" placeholder="you@example.com"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" />
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Пароль
        <input id="password" type="password" autocomplete="new-password" placeholder="Минимум 8 символов"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Подтвердить пароль
        <input id="confirmPassword" type="password"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>

      <p id="register-error" class="mt-3 hidden text-sm text-red-700"></p>
      <button type="submit"
        class="interactive-btn mt-4 min-h-11 w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white">Продолжить</button>
      <p class="mt-3 text-sm text-neutral-600">Уже есть аккаунт? <a href="/login" class="underline">Войти</a></p>
    </form>
  </main>

  <script nonce="<%= cspNonce %>">
    const form = document.getElementById("register-form");
    const errorNode = document.getElementById("register-error");
    const registerErrorByCode = {
      VALIDATION_ERROR: "Проверьте данные формы и попробуйте ещё раз.",
      LOGIN_TAKEN: "Этот логин уже занят. Войдите или выберите другой.",
      EMAIL_TAKEN: "Этот email уже зарегистрирован. Войдите или используйте другой.",
    };

    function resolveRegisterError(payload) {
      if (payload && typeof payload.code === "string" && registerErrorByCode[payload.code]) {
        return registerErrorByCode[payload.code];
      }
      return payload?.error || "Ошибка регистрации";
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorNode.classList.add("hidden");
      const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";
      const body = {
        firstName: document.getElementById("firstName").value,
        city: document.getElementById("city").value,
        profileType: document.getElementById("profileType").value,
        login: document.getElementById("login").value,
        email: document.getElementById("email").value,
        password: document.getElementById("password").value,
        confirmPassword: document.getElementById("confirmPassword").value,
      };
      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrf,
        },
        body: JSON.stringify(body),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok && payload && typeof payload === "object") {
        payload.error = resolveRegisterError(payload);
      }
      if (!response.ok) {
        errorNode.textContent = payload?.error || "Ошибка регистрации";
        errorNode.classList.remove("hidden");
        return;
      }
      const redirectTo = typeof payload.redirectTo === "string" && payload.redirectTo ? payload.redirectTo : "/profile";
      if (redirectTo.includes("verify-email")) {
        const nextEmail = String(payload.email || body.email || "").trim();
        const deliveryFailed = payload.emailDelivery === "failed";
        const suffix = deliveryFailed ? "&emailDelivery=failed" : "";
        window.location.href = nextEmail ? `/verify-email?email=${encodeURIComponent(nextEmail)}${suffix}` : redirectTo;
        return;
      }
      window.location.href = redirectTo;
    });
  </script>
</body>

</html>
