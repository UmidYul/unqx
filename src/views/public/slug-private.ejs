    boxing_legend: createMonochromePrivateTheme({ surfaceBg: "#4c1118", base: "#8f1e28", deep: "#24090d", accent: "#c8a24c", text: "#fff1e8", role: "#f0c6b6", muted: "#d7988a", buttonText: "#24090d", border: "#7a2b30" }),
    basketball_court: createMonochromePrivateTheme({ surfaceBg: "#8b4b20", base: "#f0b05d", deep: "#4d260f", accent: "#1f2937", text: "#fff4e4", role: "#ffe0b1", muted: "#d99f65", buttonText: "#fff1dc", border: "#b16d35" }),
    football_pitch: createMonochromePrivateTheme({ surfaceBg: "#0d4a2b", base: "#38a052", deep: "#062415", accent: "#ffffff", text: "#f4fff5", role: "#cffff0", muted: "#9ad5a6", buttonText: "#062415", border: "#4eb76a" }),
    olympic_gold: createMonochromePrivateTheme({ surfaceBg: "#8a651f", base: "#c7922e", deep: "#22180a", accent: "#f5d27a", text: "#fff7df", role: "#f3dfad", muted: "#d0ad68", buttonText: "#22180a", border: "#b98a32" }),
    color_red: createMonochromePrivateTheme({
      surfaceBg: "#5d0d18",
      base: "#8e1627",
      deep: "#3c0710",
      accent: "#ff6b85",
      text: "#fff2f5",
      role: "#ffc5d1",
      muted: "#ff9eb1",
      buttonText: "#2b050c",
      border: "#8f2438",
    }),
    color_orange: createMonochromePrivateTheme({
      surfaceBg: "#7b3403",
      base: "#c85600",
      deep: "#4f2100",
      accent: "#ffb957",
      text: "#fff4e5",
      role: "#ffd39d",
      muted: "#f5bd6d",
      buttonText: "#301200",
      border: "#aa4f10",
    }),
    color_yellow: createMonochromePrivateTheme({
      surfaceBg: "#8b6a07",
      base: "#d1a800",
      deep: "#5f4600",
      accent: "#fff3a6",
      text: "#fffbea",
      role: "#ffefb7",
      muted: "#e5ce6e",
      buttonText: "#332500",
      border: "#b18f12",
    }),
    color_green: createMonochromePrivateTheme({
      surfaceBg: "#145726",
      base: "#1f8f47",
      deep: "#0d3317",
      accent: "#b4ff82",
      text: "#f2fff4",
      role: "#d7ffd5",
      muted: "#a7e0a7",
      buttonText: "#0d2814",
      border: "#2a7d44",
    }),
    color_teal: createMonochromePrivateTheme({
      surfaceBg: "#0b4e54",
      base: "#0f8c93",
      deep: "#072f33",
      accent: "#91f8ff",
      text: "#ecffff",
      role: "#c6fbff",
      muted: "#9ad6da",
      buttonText: "#07282c",
      border: "#17727a",
    }),
    color_blue: createMonochromePrivateTheme({
      surfaceBg: "#123d8a",
      base: "#1d63d6",
      deep: "#0b234d",
      accent: "#8fc8ff",
      text: "#eef6ff",
      role: "#cde3ff",
      muted: "#9bbbe5",
      buttonText: "#0b1f3f",
      border: "#2d5ea8",
    }),
    color_purple: createMonochromePrivateTheme({
      surfaceBg: "#5b2290",
      base: "#7a2fca",
      deep: "#33124f",
      accent: "#d6adff",
      text: "#fbf4ff",
      role: "#ecd7ff",
      muted: "#c8a7e8",
      buttonText: "#241036",
      border: "#6d3ba8",
    }),
    color_pink: createMonochromePrivateTheme({
      surfaceBg: "#8a235f",
      base: "#d53c84",
      deep: "#57163b",
      accent: "#ffb6dc",
      text: "#fff3f9",
      role: "#ffd3e8",
      muted: "#f0aad0",
      buttonText: "#360d22",
      border: "#ab3d72",
    }),
  };
  const activePrivateTokens = privateThemeTokens[pageTheme] || privateThemeTokens.default_dark;
  const privateShellStyle = [
    `--theme-card-bg:${activePrivateTokens.cardBg}`,
    `--theme-card-border:${activePrivateTokens.cardBorder}`,
    `--theme-button-primary-bg:${activePrivateTokens.buttonPrimaryBg}`,
    `--theme-button-primary-text:${activePrivateTokens.buttonPrimaryText}`,
    `--theme-button-secondary-bg:${activePrivateTokens.buttonSecondaryBg}`,
    `--theme-name-color:${activePrivateTokens.nameColor}`,
    `--theme-role-color:${activePrivateTokens.roleColor || activePrivateTokens.nameColor}`,
    `--theme-muted-color:${activePrivateTokens.mutedColor}`,
    `--theme-accent-color:${activePrivateTokens.accentColor || activePrivateTokens.nameColor}`,
    `--theme-avatar-bg:${activePrivateTokens.avatarBg}`,
    `--theme-avatar-text:${activePrivateTokens.avatarText}`,
    `--theme-card-radius:${activePrivateTokens.radius}`,
  ].join(";");
  const initials = pageOwnerName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => (part[0] ? part[0].toUpperCase() : ""))
    .join("") || "U";
%>
<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', {
    title: pageTitle,
    description: 'Введите пароль, чтобы открыть закрытую визитку на UNQX',
    image: pageImage,
    styles: ['/css/public-card.css'],
    viewportFitCover: true,
    noindex: true,
  }) %>
</head>

<body class="antialiased" data-card-theme="<%= pageTheme %>">
  <main class="private-card-screen relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-12">
    <section id="private-card-shell" class="private-card-shell w-full max-w-xl rounded-3xl border p-6 sm:p-8" style="<%= privateShellStyle %>">
      <header class="private-card-owner flex items-center gap-3 rounded-2xl border px-3 py-2.5">
        <div class="unq-ref-avatar-wrap private-card-owner-avatar-wrap" style="--avatar-size:48px;">
          <% if (pageOwnerAvatar) { %>
            <img src="<%= pageOwnerAvatar %>" alt="Аватар" class="unq-ref-avatar-img private-card-owner-avatar-image" />
          <% } else { %>
            <div class="unq-ref-avatar-fallback private-card-avatar-fallback text-sm font-semibold"><%= initials %></div>
          <% } %>
          <%- renderPrivateAvatarFrame(pageAvatarFrame) %>
        </div>
        <div class="min-w-0">
          <p class="inline-flex max-w-full items-center gap-1.5 truncate text-sm font-semibold">
            <span class="truncate"><%= pageOwnerName %></span>
            <% if (pageOwnerIsVerified) { %>
              <svg class="h-4 w-4 shrink-0 text-neutral-500" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" title="Верифицированный аккаунт">
                <path d="M12 2.5l2.2 1.8 2.8-.3 1.2 2.5 2.5 1.2-.3 2.8L21.5 12l-1.8 2.2.3 2.8-2.5 1.2-1.2 2.5-2.8-.3L12 21.5l-2.2-1.8-2.8.3-1.2-2.5-2.5-1.2.3-2.8L2.5 12l1.8-2.2-.3-2.8 2.5-1.2 1.2-2.5 2.8.3L12 2.5Zm-1.1 13.1 5-5-1.1-1.1-3.9 3.9-1.8-1.8-1.1 1.1 2.9 2.9Z"></path>
              </svg>
            <% } %>
          </p>
          <% if (pageOwnerUsername) { %>
            <p class="truncate text-xs opacity-80"><%= pageOwnerUsername %></p>
          <% } %>
        </div>
      </header>
      <% if (pageOwnerSlugs.length) { %>
        <div class="mt-4">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <% pageOwnerSlugs.forEach((ownerSlug) => { %>
              <a href="/<%= encodeURIComponent(ownerSlug) %>" class="private-card-slug-chip inline-flex items-center rounded-full border">
                <%= ownerSlug %>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="mt-6 flex justify-center">
        <div class="private-card-lock-circle inline-flex h-16 w-16 items-center justify-center rounded-full border">
          <svg class="icon-stroke h-7 w-7" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="10" width="14" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 1 1 8 0v3"></path>
          </svg>
        </div>
      </div>

      <h1 class="mt-5 text-center text-2xl font-black">Это закрытая визитка</h1>
      <p class="mt-2 text-center text-sm opacity-85">Введите пароль, чтобы просмотреть контактные данные</p>

      <p id="private-card-expired" class="<%= pageLockedReason === 'expired' ? '' : 'hidden' %> mt-3 rounded-xl border px-3 py-2 text-center text-sm">
        Время сеанса истекло. Введите пароль снова.
      </p>

      <form id="private-card-form" class="mt-5 space-y-3" novalidate>
        <div id="private-card-field-wrap" class="private-card-field-wrap">
          <input
            id="private-card-password"
            type="password"
            autocomplete="off"
            placeholder="Пароль"
            class="w-full rounded-xl border px-3 py-3 text-sm outline-none"
          />
        </div>
        <button
          id="private-card-submit"
          type="submit"
          class="interactive-btn private-card-submit min-h-11 w-full rounded-xl border px-3 py-2 text-sm font-semibold"
        >
          Открыть
        </button>
        <a
          id="private-card-back"
          href="/"
          class="interactive-btn private-card-back inline-flex min-h-11 w-full items-center justify-center rounded-xl border px-3 py-2 text-sm font-semibold"
        >
          Назад
        </a>
      </form>
      <p id="private-card-error" class="mt-3 hidden text-center text-sm font-semibold"></p>
    </section>
  </main>

  <script nonce="<%= cspNonce %>" id="private-card-data" type="application/json"><%- JSON.stringify({
    slug: pageSlug,
    lockedReason: pageLockedReason,
  }) %></script>
  <script nonce="<%= cspNonce %>" src="/js/public-private-card.js"></script>
</body>

</html>
