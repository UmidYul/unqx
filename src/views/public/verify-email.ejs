<!doctype html>
<html lang="ru">
<head>
  <%- include('../partials/head', { title: title || "Подтверждение email | UNQX", description: typeof description === 'string' ? description : undefined, noindex: true }) %>
</head>
<body class="antialiased bg-neutral-50">
  <main class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-10">
    <form id="verify-form" class="w-full rounded-2xl border border-neutral-200 bg-white p-5">
      <a href="/" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-2.5 py-1.5 text-sm font-semibold text-neutral-700">
        <img src="/brand/logo.PNG" alt="UNQX" class="h-6 w-6 rounded-md border border-neutral-200 object-cover" />
        <span>UNQX</span>
      </a>
      <h1 class="mt-4 text-2xl font-bold text-neutral-900">Проверь почту</h1>
      <p class="mt-1 text-sm text-neutral-500">Мы отправили 6-значный код</p>
      <label class="mt-4 block text-sm font-medium text-neutral-700">Email
        <input id="email" type="email" class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>
      <label class="mt-3 block text-sm font-medium text-neutral-700">Код
        <input id="code" inputmode="numeric" maxlength="24" class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-center font-mono text-xl tracking-[0.4em]" required />
      </label>
      <p id="verify-error" class="mt-3 hidden text-sm text-red-700"></p>
      <button type="submit" class="interactive-btn mt-4 min-h-11 w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white">Подтвердить</button>
      <button id="resend" type="button" class="interactive-btn mt-2 min-h-11 w-full rounded-xl border border-neutral-300 px-4 py-2 text-sm font-semibold">Отправить код повторно</button>
      <button id="defer" type="button" class="interactive-btn mt-2 min-h-11 w-full rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-2 text-sm font-semibold text-neutral-700">Подтвердить позже</button>
      <p class="mt-2 text-xs leading-5 text-neutral-500">Если код не пришёл, можно зайти сейчас. Email останется неподтверждённым, и админ сможет подтвердить его вручную.</p>
    </form>
  </main>
  <script nonce="<%= cspNonce %>">
    const emailFromQuery = new URL(window.location.href).searchParams.get("email");
    if (emailFromQuery) document.getElementById("email").value = emailFromQuery;
    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";
    const errorNode = document.getElementById("verify-error");
    const codeInput = document.getElementById("code");
    const verifyErrorByCode = {
      OTP_INVALID: "Неверный код",
      OTP_INVALIDATED: "Код недействителен. Запроси новый.",
      OTP_EXPIRED: "Код устарел. Запроси новый.",
      VALIDATION_ERROR: "Проверь email и код и попробуй ещё раз.",
      EMAIL_TAKEN: "Этот email уже зарегистрирован. Войти →",
    };

    function resolveVerifyError(payload) {
      if (payload && typeof payload.code === "string" && verifyErrorByCode[payload.code]) {
        return verifyErrorByCode[payload.code];
      }
      return payload?.error || "Ошибка подтверждения";
    }

    codeInput?.addEventListener("input", () => {
      codeInput.value = String(codeInput.value || "").replace(/\D/g, "").slice(0, 6);
    });
    codeInput?.addEventListener("paste", (event) => {
      event.preventDefault();
      const raw = event.clipboardData?.getData("text") || "";
      codeInput.value = raw.replace(/\D/g, "").slice(0, 6);
    });
    document.getElementById("verify-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      errorNode.classList.add("hidden");
      const normalizedCode = String(codeInput?.value || "").replace(/\D/g, "").slice(0, 6);
      codeInput.value = normalizedCode;
      const response = await fetch("/api/auth/verify-email", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrf },
        body: JSON.stringify({
          email: document.getElementById("email").value,
          code: normalizedCode,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        errorNode.textContent = resolveVerifyError(payload);
        errorNode.classList.remove("hidden");
        return;
      }
      window.location.href = "/profile";
    });
    document.getElementById("resend").addEventListener("click", async () => {
      await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrf },
        body: JSON.stringify({ email: document.getElementById("email").value }),
      });
    });
    document.getElementById("defer").addEventListener("click", async () => {
      errorNode.classList.add("hidden");
      const response = await fetch("/api/auth/defer-email-verification", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrf },
        body: JSON.stringify({ email: document.getElementById("email").value }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        errorNode.textContent = payload?.error || "Не удалось продолжить без кода. Попробуй войти или зарегистрироваться заново.";
        errorNode.classList.remove("hidden");
        return;
      }
      window.location.href = payload?.redirectTo || "/profile";
    });
  </script>
</body>
</html>
