<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', { title: title || "Войти | UNQX" , description: typeof description==='string' ?
    description : undefined, noindex: true }) %>
  <style nonce="<%= cspNonce %>">
    .login-password-wrap {
      position: relative;
      display: block;
      width: 100%;
    }
    .login-password-input {
      width: 100%;
      padding-right: 2.75rem;
    }
    .login-password-toggle {
      position: absolute;
      top: 50%;
      right: 0.65rem;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.8rem;
      height: 1.8rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: #737373;
      cursor: pointer;
    }
    .login-password-toggle:hover {
      color: #404040;
    }
  </style>
</head>

<body class="antialiased bg-neutral-50" data-bwignore="true" data-lpignore="true" data-1p-ignore="true">
  <main class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-10">
    <form id="login-form" class="w-full rounded-2xl border border-neutral-200 bg-white p-5" data-bwignore="true"
      data-lpignore="true" data-1p-ignore="true" autocomplete="off">
      <a href="/"
        class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-2.5 py-1.5 text-sm font-semibold text-neutral-700">
        <img src="/brand/logo.PNG" alt="UNQX" class="h-6 w-6 rounded-md border border-neutral-200 object-cover" />
        <span>UNQX</span>
      </a>
      <h1 class="mt-4 text-2xl font-bold text-neutral-900">Войти</h1>
      <p class="mt-1 text-sm text-neutral-500">Вход в UNQX по логину и паролю</p>

      <label class="mt-4 block text-sm font-medium text-neutral-700">Логин
        <input id="login" type="text" autocomplete="username" placeholder="your-login"
          class="mt-1 w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
      </label>

      <label class="mt-3 block text-sm font-medium text-neutral-700">Пароль
        <span class="login-password-wrap mt-1">
          <input id="password" type="password" autocomplete="current-password"
            class="login-password-input rounded-xl border border-neutral-200 px-3 py-2 text-sm" required />
          <button id="password-toggle" type="button"
            class="login-password-toggle"
            aria-label="Показать пароль" aria-pressed="false">
            <svg id="password-toggle-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </button>
        </span>
      </label>

      <label class="mt-3 inline-flex w-full cursor-pointer items-center justify-between gap-3 text-sm text-neutral-700">
        <span>Запомнить меня</span>
        <span class="relative inline-flex h-6 w-11 shrink-0 items-center">
          <input id="remember-me" type="checkbox" class="peer sr-only" />
          <span class="block h-6 w-11 rounded-full bg-neutral-300 transition-colors peer-checked:bg-neutral-900"></span>
          <span
            class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-5"></span>
        </span>
      </label>

      <p id="login-error" class="mt-3 hidden text-sm text-red-700"></p>
      <button type="submit"
        class="interactive-btn mt-4 min-h-11 w-full rounded-xl bg-neutral-900 px-4 py-2 text-sm font-semibold text-white">Войти</button>

      <div class="mt-4 flex items-center justify-between text-sm">
        <a href="/forgot-password" class="text-neutral-700 underline">Забыл пароль?</a>
        <a href="/register" class="text-neutral-700 underline">Нет аккаунта? Зарегистрироваться</a>
      </div>
    </form>
  </main>

  <script nonce="<%= cspNonce %>">
    const form = document.getElementById("login-form");
    const errorNode = document.getElementById("login-error");
    const passwordInput = document.getElementById("password");
    const passwordToggle = document.getElementById("password-toggle");
    const passwordToggleIcon = document.getElementById("password-toggle-icon");
    const loginErrorByCode = {
      ACCOUNT_DISABLED: "Аккаунт отключен. Обратитесь в поддержку.",
      ACCOUNT_DEACTIVATED: "Аккаунт деактивирован. Перейди к восстановлению.",
      ACCOUNT_DELETED: "Аккаунт удален. Нужна новая регистрация.",
      LOCKED: "Слишком много попыток. Попробуйте позже.",
      UNVERIFIED: "Сначала подтвердите email.",
    };

    function resolveLoginError(payload) {
      if (payload && typeof payload.code === "string" && loginErrorByCode[payload.code]) {
        return loginErrorByCode[payload.code];
      }
      return payload?.error || "Неверный логин или пароль";
    }

    function setPasswordVisibility(visible) {
      if (!(passwordInput instanceof HTMLInputElement)) return;
      if (!(passwordToggle instanceof HTMLButtonElement)) return;
      if (!(passwordToggleIcon instanceof SVGElement)) return;
      passwordInput.type = visible ? "text" : "password";
      passwordToggle.setAttribute("aria-pressed", visible ? "true" : "false");
      passwordToggle.setAttribute("aria-label", visible ? "Скрыть пароль" : "Показать пароль");
      passwordToggleIcon.innerHTML = visible
        ? '<path d="M3 3 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.8"/><path d="M9 5.3a10.9 10.9 0 0 1 12 6.7s-3.5 6-10 6a10.8 10.8 0 0 1-5-.9" stroke="currentColor" stroke-width="1.8"/>'
        : '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.8"/>';
    }

    passwordToggle?.addEventListener("click", () => {
      if (!(passwordInput instanceof HTMLInputElement)) return;
      setPasswordVisibility(passwordInput.type === "password");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorNode.classList.add("hidden");
      const login = document.getElementById("login").value;
      const password = document.getElementById("password").value;
      const rememberMe = document.getElementById("remember-me").checked;
      const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";
      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrf,
        },
        body: JSON.stringify({ login, password, rememberMe }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        if (payload?.code === "ACCOUNT_DEACTIVATED") {
          const reactivationEmail = String(payload?.email || "").trim();
          window.location.href = `/reactivate-account?email=${encodeURIComponent(reactivationEmail)}`;
          return;
        }
        errorNode.textContent = resolveLoginError(payload);
        errorNode.classList.remove("hidden");
        return;
      }
      window.location.href = "<%= typeof next === 'string' && next ? next : '/profile' %>";
    });
  </script>
</body>

</html>

