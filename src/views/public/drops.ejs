<!doctype html>
<html lang="ru">

<head>
  <% const pageCanonicalUrl=typeof canonicalUrl==="string" ? canonicalUrl : "" ; const dropsJsonLd={ "@context"
    : "https://schema.org" , "@type" : "CollectionPage" , name: title || "Релизы slug · UNQX" , description: description
    || "Актуальные и прошедшие релизы slug на UNQX" , url: pageCanonicalUrl, }; %>
    <%- include('../partials/head', { title: title || 'Релизы slug · UNQX' , description: description
      || 'Релизы slug UNQX' , image: typeof image==='string' ? image : undefined, styles: ['/css/public-card.css'],
      jsonLd: dropsJsonLd }) %>
</head>

<body class="antialiased bg-neutral-50" data-page="drops-page"
  data-telegram-bot-username="<%= telegramBotUsername || '' %>" data-authenticated="<%= viewerUserId ? '1' : '0' %>">
  <%
    const dropsList = Array.isArray(drops) ? drops : [];
    const hasDrops = dropsList.length > 0;
    const joinedSet = new Set((Array.isArray(joinedDropIds) ? joinedDropIds : []).map((item) => String(item || "")));
    const summaryRaw = typeof dropsSummary === "object" && dropsSummary ? dropsSummary : {};
    const summary = {
      live: Number(summaryRaw.live || 0),
      upcoming: Number(summaryRaw.upcoming || 0),
      past: Number(summaryRaw.past || 0),
      total: Number(summaryRaw.total || 0),
      totalSlots: Number(summaryRaw.totalSlots || 0),
      liveRemaining: Number(summaryRaw.liveRemaining || 0),
    };
  %>

    <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <div class="mb-6 flex items-center justify-between gap-3">
        <a href="/"
          class="interactive-btn inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-semibold text-neutral-600 hover:text-neutral-900">
          <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18 9 12l6-6"></path>
          </svg>
          На главную
        </a>
        <a href="/leaderboard"
          class="interactive-btn inline-flex min-h-11 items-center gap-2 rounded-lg border border-neutral-300 px-3 py-1.5 text-sm text-neutral-500 hover:text-neutral-900">
          <img src="/brand/logo.PNG" alt="UNQX" class="h-5 w-5 rounded border border-neutral-200 object-cover" />
          <span>Топ визиток</span>
        </a>
      </div>

      <% if (!hasDrops) { %>
        <section class="box-border flex min-h-[calc(100dvh-12rem)] items-center justify-center">
          <article class="w-full max-w-lg rounded-2xl border border-neutral-200 bg-white p-8 text-center">
            <p class="text-xs uppercase tracking-[0.18em] text-neutral-500">Релизы</p>
            <h1 class="mt-3 text-2xl font-bold text-neutral-900">Пока нет активных релизов</h1>
            <p class="mt-2 text-sm text-neutral-600">Следующие запуски появятся здесь после публикации дропа.</p>
          </article>
        </section>
        <% } else { %>
          <header class="rounded-2xl border border-neutral-200 bg-white p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.18em] text-neutral-500">UNQX Drops</p>
                <h1 class="mt-2 inline-flex items-center gap-2 text-3xl font-black tracking-tight text-neutral-900">
                  <img src="/brand/logo.PNG" alt="UNQX" class="h-8 w-8 rounded-md border border-neutral-200 object-cover" />
                  <span>Релизы slug</span>
                </h1>
                <p class="mt-2 max-w-2xl text-sm text-neutral-600">Подпишись на дроп заранее, а при старте выбери slug
                  из пула и открой форму заказа в один клик.</p>
              </div>
              <div class="rounded-xl border border-neutral-200 bg-neutral-50 px-3 py-2 text-xs text-neutral-600">
                Всего слотов: <strong class="font-semibold text-neutral-900"><%= summary.totalSlots %></strong>
              </div>
            </div>

            <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
              <article class="rounded-xl border border-neutral-200 bg-neutral-50 p-3">
                <p class="text-[11px] uppercase tracking-[0.16em] text-neutral-500">LIVE</p>
                <p id="drops-stat-live" class="mt-1 text-xl font-black text-neutral-900"><%= summary.live %></p>
              </article>
              <article class="rounded-xl border border-neutral-200 bg-neutral-50 p-3">
                <p class="text-[11px] uppercase tracking-[0.16em] text-neutral-500">Ожидаются</p>
                <p id="drops-stat-upcoming" class="mt-1 text-xl font-black text-neutral-900"><%= summary.upcoming %></p>
              </article>
              <article class="rounded-xl border border-neutral-200 bg-neutral-50 p-3">
                <p class="text-[11px] uppercase tracking-[0.16em] text-neutral-500">Завершены</p>
                <p id="drops-stat-past" class="mt-1 text-xl font-black text-neutral-900"><%= summary.past %></p>
              </article>
              <article class="rounded-xl border border-neutral-200 bg-neutral-50 p-3">
                <p class="text-[11px] uppercase tracking-[0.16em] text-neutral-500">Осталось в live</p>
                <p id="drops-stat-remaining" class="mt-1 text-xl font-black text-neutral-900"><%= summary.liveRemaining %>
                </p>
              </article>
            </div>
          </header>

          <section class="mt-6 grid gap-4 md:grid-cols-2">
            <% dropsList.forEach((drop)=> {
              const pool = Array.isArray(drop.slugsPool) ? drop.slugsPool : [];
              const sold = Array.isArray(drop.soldSlugs) ? drop.soldSlugs : [];
              const total = Number(drop.slugCount) > 0 ? Number(drop.slugCount) : pool.length;
              const remaining = Math.max(0, total - sold.length);
              const isPast = Boolean(drop.isFinished || drop.isSoldOut);
              const isLive = Boolean(drop.isLive) && !isPast;
              const isUpcoming = !isLive && !isPast;
              const statusKey = isLive ? "live" : isUpcoming ? "upcoming" : "past";
              const joined = joinedSet.has(String(drop.id));
              const statusLabel = isLive ? "LIVE" : isUpcoming ? "Ожидается" : "Завершён";
              %>
              <article class="interactive-card rounded-2xl border border-neutral-200 bg-white p-5" data-drop-card
                data-drop-id="<%= drop.id %>" data-drop-at="<%= drop.dropAt.toISOString() %>"
                data-drop-status="<%= statusKey %>" data-drop-total="<%= total %>" data-drop-remaining="<%= remaining %>"
                data-drop-joined="<%= joined ? '1' : '0' %>">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h2 class="text-lg font-bold text-neutral-900">
                      <%= drop.title %>
                    </h2>
                    <p class="mt-1 text-sm text-neutral-500">
                      <%= drop.description || 'Релиз slug ограниченным пулом.' %>
                    </p>
                  </div>
                  <span data-drop-status-badge
                    class="rounded-full border px-2 py-1 text-[11px] font-semibold <%= isLive ? 'border-red-200 bg-red-50 text-red-700' : isUpcoming ? 'border-neutral-300 text-neutral-700' : 'border-neutral-200 bg-neutral-100 text-neutral-500' %>">
                    <%= statusLabel %>
                  </span>
                </div>

                <p class="mt-4 text-sm text-neutral-700"><strong>
                    <%= new Date(drop.dropAt).toLocaleString('ru-RU') %>
                  </strong> · <%= total %> slug</p>
                <p class="mt-1 text-sm text-neutral-600" data-drop-remaining>Осталось <%= remaining %> из <%= total %></p>

                <p class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-red-700 <%= isLive ? '' : 'hidden' %>"
                  data-drop-live-label>
                  <span class="status-dot is-private" aria-hidden="true"></span>
                  ДРОП НАЧАЛСЯ
                </p>
                <p class="mt-2 text-sm text-neutral-500 <%= isUpcoming ? '' : 'hidden' %>" data-drop-countdown>Старт через
                  --:--:--</p>
                <p class="mt-2 text-xs text-neutral-500 <%= isPast ? '' : 'hidden' %>" data-drop-note>Этот релиз завершён.
                </p>

                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <button type="button" data-drop-join="<%= drop.id %>"
                    class="interactive-btn min-h-11 rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 <%= isUpcoming ? '' : 'hidden' %>"
                    <%= joined ? 'disabled' : '' %>>
                    <%= joined ? 'Уведомление включено' : 'Напомнить в Telegram' %>
                  </button>

                  <a href="#drop-order" data-drop-open-live
                    class="interactive-btn inline-flex min-h-11 items-center rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 <%= isLive ? '' : 'hidden' %>">
                    Выбрать slug
                  </a>
                </div>
              </article>
              <% }) %>
          </section>

          <section id="drop-order" class="mt-8 rounded-2xl border border-neutral-200 bg-white p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold">Доступные slug прямо сейчас</h2>
                <p class="mt-1 text-sm text-neutral-500">Выбери slug из live-релиза. Кнопка откроет форму заказа с
                  привязкой к дропу.</p>
              </div>
              <button type="button" id="drops-live-refresh"
                class="interactive-btn min-h-11 rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700">
                Обновить список
              </button>
            </div>
            <div class="mt-4" id="drops-live-pool">
              <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-500">Загрузка live
                релизов...</div>
            </div>
          </section>
          <% } %>
    </main>

    <div id="drops-toast-region" aria-live="polite"
      class="pointer-events-none fixed bottom-4 right-4 z-50 hidden max-w-sm rounded-xl border border-neutral-200 bg-white px-4 py-3 text-sm text-neutral-700 shadow-lg">
    </div>
    <%- include('../partials/order-modal') %>
      <script nonce="<%= cspNonce %>" src="/js/site-dialogs.js"></script>
      <script nonce="<%= cspNonce %>" src="/js/order-modal.js"></script>
      <script nonce="<%= cspNonce %>" src="/js/drops.js"></script>
</body>

</html>
