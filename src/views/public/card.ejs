<% const pageTitle=typeof title==="string" && title ? title : "UNQX" ; const pageDescription=typeof
  description==="string" && description ? description : "UNQX platform for digital business cards" ; const
  pageImage=typeof image==="string" && image ? image : null; const pageCardRaw=typeof card==="object" && card ? card :
  {}; const pageBaseUrl=typeof baseUrl==="string" && baseUrl ? baseUrl : "" ; const pageCanonicalUrl=typeof
  canonicalUrl==="string" && canonicalUrl ? canonicalUrl : `${pageBaseUrl}/${pageCardRaw.slug || "unknown" }`; const
  pageShareUrl=pageCanonicalUrl.includes("?") ? `${pageCanonicalUrl}&src=share` : `${pageCanonicalUrl}?src=share`; const
  pageCardThemes = [
  "default_dark", "arctic", "linen", "marble", "forest", "sage_luxe", "midnight_obsidian", "golden_noir",
  "aurora_codex", "nebula_glass", "galaxy", "velours", "graffiti_neon", "color_red", "color_orange", "color_yellow",
  "color_green", "color_teal", "color_blue", "color_purple", "color_pink", "heritage_crest", "ivory_tennis",
  "grand_slam_clay", "racing_green", "polo_navy", "alpine_ski", "boxing_legend", "basketball_court",
  "football_pitch", "olympic_gold", "anime_blush", "cheetah_spots", "serpent_scale",
  ]; const pageAvatarFrames = [
  "none", "chrome_ring", "neon_spray", "sticker_bubble", "chain_link", "pixel_glow", "starburst", "drip_outline",
  "tape_collage", "orbit_dots", "laurel_wreath", "trophy_gold", "tennis_lines", "racing_stripes", "varsity_patch",
  "boxing_rope", "basketball_arc", "football_stitch", "stopwatch_ring", "medal_ribbon",
  ]; const pageEmojiBackgroundPacks = [
  "none", "ghosts", "stars", "lightning", "crowns", "webs", "hearts",
  ]; const pagePetTypes = [
  "kitten", "puppy", "snake",
  ]; const
  isSupportedButtonHref=(value)=> /^(https?:\/\/|mailto:|tel:|card:)/i.test(String(value || "").trim());
  const parseCardDigits = (rawValue) => {
  const digits = String(rawValue || "").replace(/\D/g, "");
  if (digits.length < 12 || digits.length> 19) {
    return "";
    }
    return digits;
    };
    const normalizeButtonUrl = (rawUrl, type, label) => {
    const input = String(rawUrl || "").trim();
    const kindRaw = String(type || "other")
    .trim()
    .toLowerCase();
    const kind = kindRaw === "карта" ? "card" : kindRaw;
    const labelRaw = String(label || "").trim().toLowerCase();
    const cardLikeLabel = /(карта|card)/i.test(labelRaw);
    const mapLikeLabel = /(map|maps|geo|location|локац)/i.test(labelRaw);
    if (!input) return "";
    if (isSupportedButtonHref(input)) return input;
    if (kind === "card" || cardLikeLabel) {
    const digits = parseCardDigits(input);
    return digits ? `card:${digits}` : "";
    }
    if (kind === "map" || mapLikeLabel) {
    if (/^-?\d{1,2}(?:\.\d+)?\s*,\s*-?\d{1,3}(?:\.\d+)?$/.test(input)) {
    return `https://maps.google.com/?q=${encodeURIComponent(input)}`;
    }
    return `https://maps.google.com/?q=${encodeURIComponent(input)}`;
    }

    if (kind === "phone") {
    const compact = input.replace(/\s+/g, "");
    return compact ? `tel:${compact}` : "";
    }
    if (kind === "website" || kind === "other") {
    if (/^[^\s]+\.[^\s]+$/.test(input) && !input.startsWith("@")) {
    return `https://${input}`;
    }
    }
    if (kind === "telegram") {
    const normalized = input.replace(/^@+/, "").replace(/^https?:\/\/t\.me\//i, "").trim();
    return normalized ? `https://t.me/${normalized}` : "";
    }
    if (kind === "instagram") {
    const normalized = input
    .replace(/^@+/, "")
    .replace(/^https?:\/\/(www\.)?instagram\.com\//i, "")
    .replace(/\/+$/, "")
    .trim();
    return normalized ? `https://instagram.com/${normalized}` : "";
    }
    if (kind === "tiktok") {
    const normalized = input
    .replace(/^https?:\/\/(www\.)?tiktok\.com\//i, "")
    .replace(/^@+/, "")
    .replace(/\/+$/, "")
    .trim();
    if (!normalized) return "";
    return normalized.startsWith("@") ? `https://tiktok.com/${normalized}` : `https://tiktok.com/@${normalized}`;
    }
    if (kind === "youtube") {
    if (/^(?:@[\w.-]+)$/i.test(input)) return `https://youtube.com/${input}`;
    if (/^[\w.-]+$/i.test(input)) return `https://youtube.com/@${input}`;
    }
    if (kind === "whatsapp") {
    const digits = input.replace(/[^\d]/g, "");
    return digits ? `https://wa.me/${digits}` : "";
    }
    return input;
    };

    const pageCard = {
    slug: (typeof pageCardRaw.slug === "string" ? pageCardRaw.slug : "unknown").toUpperCase(),
    slugs: Array.isArray(pageCardRaw.slugs)
    ? pageCardRaw.slugs
    .map((item) => String(item || "").trim().toUpperCase())
    .filter((item) => item.length > 0)
    : [],
    slugPrice: Number.isFinite(Number(pageCardRaw.slugPrice)) ? Number(pageCardRaw.slugPrice) : null,
    slugSaleListings: (() => {
    const listings = pageCardRaw.slugSaleListings && typeof pageCardRaw.slugSaleListings === "object"
    ? pageCardRaw.slugSaleListings
    : {};
    return Object.fromEntries(
    Object.entries(listings)
    .map(([key, value]) => {
    const slugKey = String(key || "").trim().toUpperCase();
    const salePrice = Number(value && typeof value === "object" ? value.salePrice : value);
    return slugKey && Number.isFinite(salePrice) && salePrice > 0 ? [slugKey, { salePrice }] : null;
    })
    .filter(Boolean),
    );
    })(),
    avatarUrl: pageCardRaw.avatarUrl || null,
    name: pageCardRaw.name || "Unknown",
    role: typeof pageCardRaw.role === "string" ? pageCardRaw.role.trim() : "",
    bio: typeof pageCardRaw.bio === "string" ? pageCardRaw.bio.trim() : "",
    verified: Boolean(pageCardRaw.verified),
    verifiedCompany: typeof pageCardRaw.verifiedCompany === "string" ? pageCardRaw.verifiedCompany.trim() : "",
    tariff: pageCardRaw.tariff === "premium" ? "premium" : "none",
    theme:
    (() => {
    const normalizedTheme = pageCardRaw.theme === "royal_ivory" ? "sage_luxe" : pageCardRaw.theme;
    return typeof normalizedTheme === "string" && pageCardThemes.includes(normalizedTheme) ? normalizedTheme : "default_dark";
    })(),
    avatarFrame:
    pageCardRaw.tariff === "premium" &&
    typeof pageCardRaw.avatarFrame === "string" &&
    pageAvatarFrames.includes(pageCardRaw.avatarFrame)
    ? pageCardRaw.avatarFrame
    : "none",
    emojiBackgroundPack:
    pageCardRaw.tariff === "premium" &&
    typeof pageCardRaw.emojiBackgroundPack === "string" &&
    pageEmojiBackgroundPacks.includes(pageCardRaw.emojiBackgroundPack)
    ? pageCardRaw.emojiBackgroundPack
    : "none",
    customColor: /^#[0-9a-fA-F]{6}$/.test(String(pageCardRaw.customColor || "").trim())
    ? String(pageCardRaw.customColor || "").trim().toLowerCase()
    : "",
    phone: pageCardRaw.phone || "",
    tags: Array.isArray(pageCardRaw.tags)
    ? pageCardRaw.tags
    .map((tag) => ({
    label: typeof tag.label === "string" ? tag.label.trim() : "",
    }))
    .filter((tag) => tag.label.length > 0)
    : [],
    buttons: Array.isArray(pageCardRaw.buttons)
    ? pageCardRaw.buttons
    .map((button) => ({
    type: typeof button.type === "string" ? button.type.trim().toLowerCase() : "other",
    label: typeof button.label === "string" ? button.label.trim() : "",
    url: normalizeButtonUrl(
    button && (button.href || button.value || button.url || ""),
    button?.type || "other",
    button?.label || "",
    ),
    isActive: Boolean(button.isActive),
    }))
    .filter((button) => button.isActive && button.label.length > 0 && isSupportedButtonHref(button.url))
    : [],
    hashtag: pageCardRaw.hashtag || "",
    address: pageCardRaw.address || "",
    postcode: pageCardRaw.postcode || "",
    email: pageCardRaw.email || "",
    extraPhone: pageCardRaw.extraPhone || "",
    viewsCount: Number(pageCardRaw.viewsCount) || 0,
    showBranding: typeof pageCardRaw.showBranding === "boolean" ? pageCardRaw.showBranding : true,
    selectedTrack: (() => {
    const track = pageCardRaw.selectedTrack && typeof pageCardRaw.selectedTrack === "object" ? pageCardRaw.selectedTrack : null;
    if (!track) return null;
    const title = String(track.title || "").trim();
    const audioUrl = String(track.audioUrl || track.audio_url || "").trim();
    return title && audioUrl ? { title, audioUrl } : null;
    })(),
    pets: Array.isArray(pageCardRaw.pets)
    ? pageCardRaw.pets
    .map((pet) => {
    const petType = typeof pet?.petType === "string" ? pet.petType.trim().toLowerCase() : "";
    if (!pagePetTypes.includes(petType)) return null;
    return {
    id: typeof pet?.id === "string" ? pet.id.trim() : "",
    petType,
    label: typeof pet?.label === "string" ? pet.label.trim() : "",
    assetUrl: typeof pet?.assetUrl === "string" && pet.assetUrl.trim() ? pet.assetUrl.trim() : `/assets/pets/${petType}.svg`,
    displayName: typeof pet?.displayName === "string" ? pet.displayName.trim() : "",
    priceSnapshot: Number.isFinite(Number(pet?.priceSnapshot)) ? Number(pet.priceSnapshot) : 0,
    isVisible: typeof pet?.isVisible === "boolean" ? pet.isVisible : true,
    createdAt: pet?.createdAt || null,
    };
    })
    .filter((pet) => pet && pet.displayName.length > 0)
    : [],
    };

    const pageJsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: pageCanonicalUrl,
    name: pageTitle,
    mainEntity: {
    "@type": "Person",
    name: pageCard.name,
    telephone: pageCard.phone || undefined,
    email: pageCard.email || undefined,
    image: pageImage || undefined,
    sameAs: pageCard.buttons.map((button) => button.url),
    },
    };

    const initials = (pageCard.name || "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => (part[0] ? part[0].toUpperCase() : ""))
    .join("");

    const actionButtons = pageCard.buttons.slice(0, 4).map((button) => {
    const signature = `${button.label} ${button.url}`.toLowerCase();
    let icon = "arrow";
    if (/(telegram|t\.me|message|chat)/.test(signature)) {
    icon = "message";
    } else if (/(instagram|insta)/.test(signature)) {
    icon = "instagram";
    } else if (/(click|pay|payment|card|kaspi|merchant)/.test(signature)) {
    icon = "click";
    } else if (/(phone|call|tel)/.test(signature)) {
    icon = "phone";
    } else if (/(site|web|link|globe|www)/.test(signature)) {
    icon = "globe";
    } else if (/(steam|trade|shop|store|market)/.test(signature)) {
    icon = "arrow";
    }

    return {
    label: button.label,
    url: button.url,
    icon,
    };
    });

    function findSocialUrl(patterns) {
    const found = pageCard.buttons.find((button) => patterns.some((pattern) => pattern.test(`${button.label}
    ${button.url}`)));
    return found ? found.url : "#";
    }

    const socialLinks = [
    { label: "Instagram", url: findSocialUrl([/instagram/i, /insta/i]), icon: "instagram" },
    { label: "LinkedIn", url: findSocialUrl([/linkedin/i]), icon: "linkedin" },
    { label: "TikTok", url: findSocialUrl([/tiktok/i, /tik tok/i]), icon: "tiktok" },
    { label: "YouTube", url: findSocialUrl([/youtube/i, /youtu\.be/i]), icon: "youtube" },
    ];

    const mainHashtag = pageCard.hashtag
    ? pageCard.hashtag.startsWith("#")
    ? pageCard.hashtag
    : `#${pageCard.hashtag}`
    : "#UnqPower2026";
    const aboutAddress = pageCard.address || "";
    const aboutEmail = pageCard.email || "";
    const aboutPhone = pageCard.extraPhone || "";
    const aboutPostcode = pageCard.postcode || "";
    const documentDir = /[\u0600-\u06FF]/.test(pageCard.name || "") ? "rtl" : "ltr";
    const formattedViews = new Intl.NumberFormat("ru-RU").format(Math.max(0, pageCard.viewsCount));
    const pageCardTheme = pageCard.tariff === "premium" ? pageCard.theme : "default_dark";
    const pageTopBadge = typeof topBadge === "object" && topBadge ? topBadge : null;
    const pageScore = typeof score === "object" && score ? score : null;
    %>
    <!doctype html>
    <html lang="ru" dir="<%= documentDir %>">

    <head>
      <%- include('../partials/head', { title: pageTitle, description: pageDescription, image: pageImage, styles:
        ['/css/public-card.css'], ogType: 'profile' , jsonLd: pageJsonLd, viewportFitCover: true, noindex: typeof noindex==='boolean' ? noindex
        : false }) %>
    </head>

    <body class="antialiased" data-card-theme="<%= pageCardTheme %>">
      <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-12">
        <div id="public-card-layout" class="relative z-10 w-full max-w-[640px]">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2 sm:flex-nowrap">
            <a href="/"
              class="interactive-btn inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700">
              <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18 9 12l6-6"></path>
              </svg>
              На главную
            </a>
            <form id="card-slug-search-form"
              class="ml-auto flex w-full max-w-[220px] items-center gap-2 sm:max-w-[340px]" action="/" method="get"
              novalidate>
              <label for="card-slug-search-input" class="sr-only">Поиск UNQ</label>
              <div class="flex min-w-0 flex-1 items-center rounded-lg border border-neutral-200 bg-white px-3 py-2">
                <span class="mr-2 text-xs text-neutral-400">unqx.uz/</span>
                <input id="card-slug-search-input" type="text" inputmode="text" autocomplete="off" spellcheck="false"
                  maxlength="6" placeholder="AAA001"
                  class="w-full bg-transparent text-sm uppercase text-neutral-800 outline-none placeholder:text-neutral-300" />
              </div>
              <button type="submit"
                class="interactive-btn inline-flex min-h-11 items-center justify-center rounded-lg border border-neutral-300 px-3 py-2 text-neutral-700"
                aria-label="Искать">
                <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.5-3.5"></path>
                </svg>
              </button>
            </form>
          </div>
          <div id="card-slug-search-results" class="mb-3 hidden rounded-xl border border-neutral-200 bg-white p-2">
          </div>
          <div id="card-view-root" class="animate-card-enter flex justify-center"></div>
        </div>
      </main>

      <script nonce="<%= cspNonce %>" id="card-view-data" type="application/json"><%- JSON.stringify({
    card: {
      ...pageCard,
      role: pageCard.role,
      bio: pageCard.bio,
    },
    shareUrl: pageShareUrl,
    viewsLabel: `${formattedViews} просмотров`,
    slug: pageCard.slug,
  score: pageScore,
  wall: typeof wall === "object" && wall ? wall : null,
  followSummary: typeof followSummary === "object" && followSummary ? followSummary : null,
  topBadge: pageTopBadge,
    officialUnqBadge: typeof officialUnqBadge === "object" && officialUnqBadge !== null ? officialUnqBadge : null,
    staffBadge: typeof staffBadge === "object" && staffBadge !== null ? staffBadge : null,
    viewerCommentComposer: typeof viewerCommentComposer === "object" && viewerCommentComposer ? viewerCommentComposer : null,
    privateAccess: typeof privateAccess === "object" && privateAccess ? privateAccess : null,
    paused: false,
    trackViaPageRequest: true,
  }) %></script>
      <script nonce="<%= cspNonce %>" src="/js/card-view.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
      <script nonce="<%= cspNonce %>" src="/js/public-card.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
      <script nonce="<%= cspNonce %>" src="/js/public-private-access-session.js"></script>
    </body>

    </html>
