  const name = String(item?.name || "UNQX User").trim() || "UNQX User";
  const avatarUrl = String(item?.avatarUrl || "").trim();
  return { primarySlug, name, avatarUrl };
  })
  .filter((item) => item.primarySlug);
  for (let i = homeProfileFeedList.length - 1; i > 0; i -= 1) {
  const j = Math.floor(Math.random() * (i + 1));
  [homeProfileFeedList[i], homeProfileFeedList[j]] = [homeProfileFeedList[j], homeProfileFeedList[i]];
  }

