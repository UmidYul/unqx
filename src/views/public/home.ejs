  ? advertisements
  .map((item) => ({
  imageUrl: String(item && (item.imageUrl || item.image_url) || "").trim(),
  targetUrl: String(item && (item.targetUrl || item.target_url) || "").trim(),
  placement: String(item && item.placement || "footer_partner").trim(),
  positionIndex: Number(item && (item.positionIndex || item.position_index) || 0),
  }))
  .filter((item) => item.imageUrl && /^https?:\/\//i.test(item.targetUrl))
  .sort((a, b) => a.positionIndex - b.positionIndex)
  : [];
  const headerCollaborationList = advertisementList.filter((item) => item.placement === "header_collab").slice(0, 1);
  const footerPartnerList = advertisementList.filter((item) => item.placement !== "header_collab");
  const homePromoBanner = (() => {
  const imageUrl = String(pagePublicSettings.homepage_promo_banner_image_url || "/images/card.png").trim();
  const targetUrlRaw = String(pagePublicSettings.homepage_promo_banner_target_url || "#calculator").trim();
  const targetUrl = /^(https?:\/\/|\/|#)/i.test(targetUrlRaw) ? targetUrlRaw : "#calculator";
  const alt = String(pagePublicSettings.homepage_promo_banner_alt || "UNQX Promo Banner").trim();
  return { imageUrl, targetUrl, alt };
  })();
  const trimMetricDecimal = (value) => String(value).replace(/\.0$/, "");
  const formatHomePostMetric = (value) => {
  const amount = Math.max(0, Number(value || 0));
  if (!Number.isFinite(amount)) {
  return "0";
  }
  if (amount >= 1_000_000) {
  return `${trimMetricDecimal((amount / 1_000_000).toFixed(amount >= 10_000_000 ? 0 : 1))}M`;
  }
  if (amount >= 1_000) {
  return `${trimMetricDecimal((amount / 1_000).toFixed(amount >= 10_000 ? 0 : 1))}K`;
  }
  return amount.toLocaleString("ru-RU");
  };
  const formatHomePostDateTime = (value) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) {
  return "только что";
  }
  const diffMs = Math.max(0, Date.now() - date.getTime());
  const plural = (amount, one, few, many) => {
  const mod10 = amount % 10;
  const mod100 = amount % 100;
  if (mod10 === 1 && mod100 !== 11) return one;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few;
  return many;
  };
  const units = [
  { ms: 30 * 24 * 60 * 60 * 1000, forms: ["месяц", "месяца", "месяцев"] },
  { ms: 7 * 24 * 60 * 60 * 1000, forms: ["неделю", "недели", "недель"] },
  { ms: 24 * 60 * 60 * 1000, forms: ["день", "дня", "дней"] },
  { ms: 60 * 60 * 1000, forms: ["час", "часа", "часов"] },
  { ms: 60 * 1000, forms: ["минуту", "минуты", "минут"] },
  { ms: 1000, forms: ["секунду", "секунды", "секунд"] },
  ];
  for (const unit of units) {
  if (diffMs >= unit.ms) {
  const amount = Math.max(1, Math.floor(diffMs / unit.ms));
  return `${amount} ${plural(amount, ...unit.forms)} назад`;
  }
  }
  return "только что";
  };
  const formatHomePostHandle = (author) => {
  const raw = String(author && typeof author === "object" ? (author.handle || author.name || author.primarySlug || "unqx") : "unqx").trim();
  const compact = raw.replace(/\s+/g, "");
  if (!compact) {
  return "@unqx";
  }
  return compact.startsWith("@") ? compact : `@${compact}`;
  };
  const buildHomeCommentsHref = (href, postId) => {
  const normalizedHref = String(href || "").trim() || "/";
  const normalizedPostId = String(postId || "").trim();
  if (!normalizedPostId) {
  return normalizedHref;
  }
  try {
  const baseUrlForResolve = pageBaseUrl || pageCanonicalUrl || "https://unqx.uz";
  const url = new URL(normalizedHref, baseUrlForResolve);
  url.searchParams.set("comments", "1");
  url.hash = `wall-post-${encodeURIComponent(normalizedPostId)}`;
  const isAbsoluteHref = /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(normalizedHref);
  return isAbsoluteHref ? url.toString() : `${url.pathname}${url.search}${url.hash}`;
  } catch {
  const hashIndex = normalizedHref.indexOf("#");
  const base = hashIndex >= 0 ? normalizedHref.slice(0, hashIndex) : normalizedHref;
  const hash = hashIndex >= 0 ? normalizedHref.slice(hashIndex) : `#wall-post-${encodeURIComponent(normalizedPostId)}`;
  const separator = base.includes("?") ? "&" : "?";
  return `${base}${separator}comments=1${hash}`;
  }
  };

