                    <% if (!latestSlackCards.length) { %>
                      <div
                        class="mx-auto mt-8 max-w-3xl rounded-2xl border border-neutral-200 bg-white p-6 text-center text-sm text-neutral-500">
                        Пока нет созданных визиток для отображения.
                      </div>
                      <% } else { %>
                        <div class="home-latest-unq-list">
                          <% latestSlackCards.forEach((card, index)=> {
                            const latestInitials = (card.name || "UN").split(" ").map((p) => p[0]).join("").slice(0, 2).toUpperCase();
                            const latestProfileSlug = String(card.slug || card.username || card.handle || "UNQ").trim().replace(/^@+/, "").toUpperCase();
                            const latestProfileLink = `unqx.uz/${latestProfileSlug || "UNQ"}`;
                          %>
                            <a href="/<%= encodeURIComponent(card.slug) %>"
                              class="home-latest-unq-card interactive-card"
                              aria-label="Открыть профиль <%= card.name %>">
                              <% if (card.avatarUrl) { %>
                                <img src="<%= card.avatarUrl %>" alt="<%= card.name %>"
                                  class="home-latest-unq-avatar"
                                  loading="lazy" />
                              <% } else { %>
                                <span class="home-latest-unq-avatar home-latest-unq-avatar-fallback"><%= latestInitials %></span>
                              <% } %>
                              <span class="home-latest-unq-copy">
                                <span class="home-latest-unq-name-row">
                                  <span class="home-latest-unq-name"><%= card.name %></span>
                                  <% if (card.isVerified || card.verified) { %>
                                    <svg class="home-latest-unq-verified" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                                      <path d="M12 2.5l2.2 1.8 2.8-.3 1.2 2.5 2.5 1.2-.3 2.8L21.5 12l-1.8 2.2.3 2.8-2.5 1.2-1.2 2.5-2.8-.3L12 21.5l-2.2-1.8-2.8.3-1.2-2.5-2.5-1.2.3-2.8L2.5 12l1.8-2.2-.3-2.8 2.5-1.2 1.2-2.5 2.8.3L12 2.5Zm-1.1 13.1 5-5-1.1-1.1-3.9 3.9-1.8-1.8-1.1 1.1 2.9 2.9Z"></path>
                                    </svg>
                                  <% } %>
                                </span>
                                <span class="home-latest-unq-username"><%= latestProfileLink %></span>
                              </span>
                            </a>
                            <% }) %>
                        </div>
                        <% } %>
                  </div>
                </section>
                <% } %>

                <% if (homeBlockVisible("homepage_views_ranking_visible")) { %>
                <section id="weekly-top-views" class="px-6 py-16" data-observe-reveal>
                  <div class="mx-auto max-w-6xl">
                    <p class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">Топ 3 дня</p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 md:text-4xl">Рейтинг по просмотрам</h2>

                    <% if (!weeklyViewsTopList.length) { %>
                      <div class="mt-8 rounded-2xl border border-neutral-200 bg-white p-6 text-sm text-neutral-500">
                        За эту неделю пока нет данных по просмотрам.
                      </div>
                      <% } else { %>
                        <div class="home-showcase-list">
                          <% weeklyViewsTopList.forEach((item, index)=> {
                            const rankNumber = index + 1;
                            const slugs = (Array.isArray(item.slugs) ? item.slugs : []).filter(Boolean);
                            const primaryWeeklySlug = String(item.primarySlug || slugs[0] || "").trim();
                            const weeklyViewsCount = Number(item.views || 0).toLocaleString('ru-RU');
                          %>
                            <a href="/<%= encodeURIComponent(item.primarySlug || (Array.isArray(item.slugs) ? item.slugs[0] : '')) %>"
                              aria-label="Открыть профиль <%= item.name %>"
                              class="home-showcase-item home-showcase-item--views home-showcase-item--rank-<%= rankNumber %> interactive-card">
                              <span class="home-showcase-rank"><%= rankNumber %><% if (rankNumber === 1) { %><span class="home-showcase-rank-crown" aria-hidden="true">♛</span><% } %></span>
                              <span class="home-showcase-card">
                                <img src="<%= item.avatarUrl || '/brand/logo.PNG' %>" alt="<%= item.name %>"
                                  onerror="this.onerror=null;this.src='/brand/logo.PNG';"
                                  class="home-showcase-avatar" />
                                <span class="home-showcase-copy">
                                  <span class="home-showcase-name-row">
                                    <span class="home-showcase-name"><%= item.name %></span>
                                    <% if (item.isVerified) { %>
                                      <svg class="home-showcase-verified" viewBox="0 0 24 24" aria-hidden="true"
                                        fill="currentColor" title="Верифицированный аккаунт">
                                        <path
                                          d="M12 2.5l2.2 1.8 2.8-.3 1.2 2.5 2.5 1.2-.3 2.8L21.5 12l-1.8 2.2.3 2.8-2.5 1.2-1.2 2.5-2.8-.3L12 21.5l-2.2-1.8-2.8.3-1.2-2.5-2.5-1.2.3-2.8L2.5 12l1.8-2.2-.3-2.8 2.5-1.2 1.2-2.5 2.8.3L12 2.5Zm-1.1 13.1 5-5-1.1-1.1-3.9 3.9-1.8-1.8-1.1 1.1 2.9 2.9Z">
                                        </path>
                                      </svg>
                                    <% } %>
                                  </span>
                                  <span class="home-showcase-slug">unqx.uz/<%= primaryWeeklySlug || "UNQ" %></span>
                                </span>
                                <span class="home-showcase-score"><%= weeklyViewsCount %></span>
                              </span>
                            </a>
                            <% }) %>
                        </div>
                        <% } %>
                  </div>
                </section>
                <% } %>
                <% const homeAuction = activeAuction && typeof activeAuction === "object" ? activeAuction : null; %>
                <% if (homeAuction && homeBlockVisible("homepage_auction_visible")) { %>
                  <% const auctionSlug = String(homeAuction.slug || "").toUpperCase(); %>
                  <% const auctionSlugDisplay = auctionSlug.length > 3 ? `${auctionSlug.slice(0, 3)} ${auctionSlug.slice(3)}` : auctionSlug; %>
                  <% const auctionStartingPrice = Number(homeAuction.startingPrice || 0); %>
                  <% const auctionCurrentBid = Number(homeAuction.currentBid || 0); %>
                  <% const auctionMinStep = Number(homeAuction.minStep || 0); %>
                  <% const auctionNextBid = Math.max(auctionStartingPrice, auctionCurrentBid > 0 ? auctionCurrentBid + auctionMinStep : auctionStartingPrice); %>
                  <% const auctionIsDemo = String(homeAuction.id || "") === "demo"; %>
                  <% const auctionStatus = String(homeAuction.status || "active"); %>
                  <section id="auction" class="home-auction-section px-6 py-16" data-observe-reveal>
                    <div class="home-auction-card" data-auction-widget data-auction-id="<%= homeAuction.id %>"
                      data-auction-status="<%= auctionStatus %>"
                      data-auction-ends-at="<%= homeAuction.endsAt ? new Date(homeAuction.endsAt).toISOString() : '' %>"
                      data-auction-starting-price="<%= auctionStartingPrice %>" data-auction-current-bid="<%= auctionCurrentBid %>"
                      data-auction-min-step="<%= auctionMinStep %>" data-auction-demo="<%= auctionIsDemo ? '1' : '0' %>">
                      <div class="home-auction-head">
                        <div>
                          <p class="home-auction-kicker">Текущий лот</p>
                          <div class="home-auction-lot" data-auction-slug><%= auctionSlugDisplay %></div>
                        </div>
                        <div class="home-auction-status-wrap">
                          <span class="home-auction-status" data-auction-status-label><%= auctionStatus === 'finished' ? 'ЗАВЕРШЕН' : 'АКТИВЕН' %></span>
                          <span class="home-auction-deadline">до конца</span>
                        </div>
                      </div>

                      <div class="home-auction-countdown" aria-label="Таймер аукциона">
                        <div class="home-auction-timebox"><strong data-auction-count="days">00</strong><span>д</span></div>
                        <div class="home-auction-timebox"><strong data-auction-count="hours">00</strong><span>ч</span></div>
                        <div class="home-auction-timebox"><strong data-auction-count="minutes">00</strong><span>м</span></div>
                        <div class="home-auction-timebox"><strong data-auction-count="seconds">00</strong><span>с</span></div>
                      </div>

                      <div class="home-auction-grid">
                        <div class="home-auction-bid-panel">
                          <span>Текущая ставка</span>
                          <strong data-auction-current-bid><%= auctionCurrentBid.toLocaleString('ru-RU') %> сум</strong>
                          <small data-auction-leader>Лидирует: <%= homeAuction.leader && homeAuction.leader.username ? '@' + homeAuction.leader.username : 'пока никто' %></small>
                        </div>
                        <form class="home-auction-form" data-auction-form>
                          <label>
                            <span>Новая ставка</span>
                            <input class="home-auction-input" data-auction-bid-input type="number" min="<%= auctionNextBid %>"
                              step="<%= auctionMinStep || 1000 %>" value="<%= auctionNextBid %>" <%= auctionStatus === 'finished' || auctionIsDemo ? 'disabled' : '' %> />
                          </label>
                          <button class="home-auction-submit" data-auction-bid-submit type="submit" <%= auctionStatus === 'finished' || auctionIsDemo ? 'disabled' : '' %>>
                            Сделать ставку
                          </button>
                          <p class="home-auction-feedback" data-auction-feedback><%= auctionIsDemo ? 'Демо-лот: создайте реальный лот в админке.' : '' %></p>
                        </form>
                      </div>

                      <div class="home-auction-history">
                        <div class="home-auction-history-head">
                          <span>История ставок</span>
                          <span>последние 5</span>
                        </div>
                        <div class="home-auction-history-list" data-auction-history>
                          <% const auctionBids = Array.isArray(homeAuction.bids) ? homeAuction.bids.slice(0, 5) : []; %>
                          <% if (auctionBids.length) { %>
                            <% auctionBids.forEach((bid) => { %>
                              <% const bidName = String(bid.username || bid.bidderUsername || bid.name || bid.bidderName || 'user').replace(/^@+/, ''); %>
                              <div class="home-auction-history-row">
                                <span class="home-auction-avatar"><%= bidName.slice(0, 1).toUpperCase() || 'U' %></span>
                                <span class="home-auction-bidder">@<%= bidName %></span>
                                <strong><%= Number(bid.amount || 0).toLocaleString('ru-RU') %> сум</strong>
                                <time data-auction-bid-time datetime="<%= bid.createdAt ? new Date(bid.createdAt).toISOString() : '' %>">только что</time>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <div class="home-auction-empty">Стань первым участником этого лота.</div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </section>
                <% } %>
                <% if (homeBlockVisible("homepage_faq_visible")) { %>
                <section id="faq" class="px-6 py-24" data-observe-reveal>
                  <div class="mx-auto max-w-4xl">
                    <p class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">ВОПРОСЫ</p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 md:text-4xl">Часто спрашивают
                    </h2>

                    <div class="mt-8 space-y-3">
                      <% faqItems.forEach((item)=> { %>
                        <details class="faq-item group rounded-2xl border border-neutral-200 bg-white p-4">
                          <summary
                            class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-neutral-900">
                            <span>
                              <%= item.q %>
                            </span>
                            <span class="text-neutral-400 transition-transform group-open:rotate-45">+</span>
                          </summary>
                          <p class="mt-3 text-sm leading-relaxed text-neutral-600">
                            <%= item.a %>
                          </p>
                        </details>
                        <% }) %>
                    </div>
                  </div>
                </section>
                <% } %>

                <%- include('../partials/order-modal') %>

                  <footer class="border-t border-neutral-200 px-6 py-16">
                    <div class="mx-auto max-w-6xl">
                      <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
                        <div>
                          <div class="home-footer-brand-row">
                            <a href="/" class="inline-flex items-center gap-2 text-xl font-black text-neutral-900">
                              <img src="/brand/logo.PNG" alt="<%= platformName %>"
                                class="h-8 w-8 rounded-md border border-neutral-200 object-cover" />
                              <span>
                                <%= platformName %>
                              </span>
                            </a>
                            <% if (footerPartnerList.length) { %>
                              <div class="home-ad-grid" aria-label="Партнёры UNQX">
                                <% footerPartnerList.forEach((banner)=> { %>
                                  <a
                                    href="<%= banner.targetUrl %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="home-ad-card"
                                    aria-label="Открыть сайт партнёра">
                                    <img
                                      src="<%= banner.imageUrl %>"
                                      alt="Партнёр UNQX"
                                      loading="lazy"
                                      class="home-ad-logo" />
                                  </a>
                                <% }) %>
                              </div>
                            <% } %>
                          </div>
                          <p class="mt-2 text-sm text-neutral-400">Цифровая визитка нового поколения</p>
                        </div>

                        <div class="flex flex-wrap gap-8 text-sm text-neutral-400">
                          <a href="/directory" class="transition-colors hover:text-neutral-900">Резиденты</a>
                          <a href="/guides" class="transition-colors hover:text-neutral-900">Инструкции</a>
                          <% if (leaderboardEnabled) { %><a href="/leaderboard"
                              class="whitespace-nowrap transition-colors hover:text-neutral-900">UNQ&nbsp;ELITE</a>
                            <% } %>
                              <a href="/terms" class="transition-colors hover:text-neutral-900">Условия</a>
                              <a href="/policy" class="transition-colors hover:text-neutral-900">Политика</a>
                              <a href="/child-safety" class="transition-colors hover:text-neutral-900">Child Safety</a>
                        </div>

                        <p class="hidden text-4xl font-bold tracking-tight text-neutral-200 md:block">unqx.uz</p>
                      </div>

                      <div class="mt-12 border-t border-neutral-200 pt-6">
                        <% if (supportPhone) { %>
                          <p class="mb-2 text-xs text-neutral-400">Телефон: <a href="tel:<%= supportPhoneHref %>"
                              class="underline transition-colors hover:text-neutral-700">
                              <%= supportPhone %>
                            </a></p>
                          <% } %>
                            <p class="text-xs text-neutral-400">&copy; 2026 <%= platformName %> · <%=
                                  String(pagePublicSettings.contact_address || "Ташкент, Узбекистан" ) %>
                            </p>
                      </div>
                    </div>
                  </footer>
      </div>
    </main>

    <script nonce="<%= cspNonce %>" src="/js/site-dialogs.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/official-unq-letters.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/order-modal.js?v=<%= encodeURIComponent(assetVersion || '') %>"></script>
    <script nonce="<%= cspNonce %>" src="/vendor/html2canvas/html2canvas.min.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/public-home-search.js"></script>
    <script nonce="<%= cspNonce %>" src="/js/public-realtime.js"></script>
  </body>

  </html>
