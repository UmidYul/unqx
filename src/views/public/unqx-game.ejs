<!doctype html>
<html lang="ru">

<head>
  <%- include('../partials/head', {
    title: title || 'UNQX Lucky | Слот',
    description: description || 'UNQX Lucky: один спин в день, только свободные AAA000 и авто-скидка 10% на выпавший slug.',
    image: typeof image === 'string' ? image : undefined,
    styles: ['/css/public-card.css', '/css/unqx-game.css'],
  }) %>
</head>

<body class="antialiased" data-page="unqx-game">
  <main class="unqx-lucky-page mx-auto w-full max-w-6xl px-4 py-8">
    <header class="mb-6 flex items-center justify-between gap-3">
      <a href="/"
        class="interactive-btn inline-flex min-h-11 items-center gap-1.5 rounded-xl border border-neutral-300 px-3 py-1.5 text-sm font-semibold text-neutral-700 hover:text-neutral-900">
        <svg class="icon-stroke h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18 9 12l6-6"></path>
        </svg>
        На главную
      </a>

      <div class="flex items-center gap-2">
        <button id="unqx-game-info-button" type="button"
          class="interactive-btn inline-flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-300 text-base font-black text-neutral-700"
          aria-label="Что это">
          ?
        </button>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">UNQX LUCKY</p>
      </div>
    </header>

    <section class="unqx-lucky-card rounded-3xl border border-neutral-300 p-6">
      <div class="mb-4 flex items-center justify-between gap-2">
        <h1 class="text-3xl font-black text-neutral-900 md:text-4xl">UNQX Lucky</h1>
        <p id="unqx-game-status" class="unqx-sr-only" aria-live="polite">Готово</p>
      </div>

      <div id="unqx-game-reel" class="unqx-game-reel rounded-2xl border border-neutral-300 p-4">
        <div id="unqx-game-slot-machine" class="unqx-game-slot-machine" aria-label="UNQX Lucky слот-машина">
          <div class="unqx-game-slot-row" role="presentation">
            <span class="unqx-game-slot" data-slot-index="0">A</span>
            <span class="unqx-game-slot" data-slot-index="1">A</span>
            <span class="unqx-game-slot" data-slot-index="2">A</span>
            <span class="unqx-game-slot is-divider" data-slot-index="3">0</span>
            <span class="unqx-game-slot" data-slot-index="4">0</span>
            <span class="unqx-game-slot" data-slot-index="5">0</span>
          </div>
        </div>

        <div id="unqx-game-result-meta" class="mt-4 hidden space-y-1">
          <p id="unqx-game-result-slug" class="text-xl font-black tracking-[0.14em] text-neutral-900">UNQX</p>
          <p id="unqx-game-result-price" class="text-base font-semibold text-neutral-800">Цена</p>
          <p id="unqx-game-result-time" class="text-xs text-neutral-500">Время</p>
        </div>

        <div id="unqx-game-lucky-box" class="mt-3 hidden rounded-xl border border-neutral-300 bg-neutral-100 px-3 py-2">
          <p id="unqx-game-lucky-text" class="text-xs font-semibold text-neutral-800">Lucky-бонус</p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button type="button" id="unqx-game-spin-button"
          class="interactive-btn min-h-11 rounded-xl bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800">
          Крутить
        </button>
        <span id="unqx-game-spin-limit" class="text-xs text-neutral-500">1 попытка в день</span>
      </div>
    </section>

    <section class="unqx-lucky-card mt-6 rounded-3xl border border-neutral-300 p-6">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h2 class="text-lg font-black text-neutral-900">Последние 5 выпадений</h2>
        <button type="button" id="unqx-game-history-refresh"
          class="interactive-btn min-h-11 rounded-xl border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700">
          Обновить
        </button>
      </div>

      <ul id="unqx-game-history-list" class="space-y-2"></ul>
      <p id="unqx-game-history-empty" class="rounded-xl border border-neutral-300 bg-neutral-100 px-4 py-3 text-sm text-neutral-500">
        История пока пустая.
      </p>
    </section>
  </main>

  <div id="unqx-game-modal-overlay" class="unqx-game-modal-overlay" aria-hidden="true">
    <div id="unqx-game-modal" class="unqx-game-modal" role="dialog" aria-modal="true" aria-labelledby="unqx-game-modal-title">
      <button id="unqx-game-modal-close" type="button" class="unqx-game-modal-close" aria-label="Закрыть">
        <span aria-hidden="true">×</span>
      </button>
      <h3 id="unqx-game-modal-title" class="unqx-game-modal-title">UNQX Lucky</h3>
      <p id="unqx-game-modal-message" class="unqx-game-modal-message">Сообщение</p>
      <div class="mt-4 flex justify-end">
        <button id="unqx-game-modal-action" type="button" class="interactive-btn unqx-game-modal-action">Понятно</button>
      </div>
    </div>
  </div>

  <script nonce="<%= cspNonce %>" src="/js/unqx-game.js"></script>
</body>

</html>
