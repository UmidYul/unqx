generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Tariff {
  basic
  premium
}

enum CardTheme {
  default_dark
  arctic
  linen
  marble
  forest
  sage_luxe
  midnight_obsidian
  golden_noir
  aurora_codex
  nebula_glass
  velours
}

enum CheckerResult {
  AVAILABLE
  TAKEN
  BLOCKED
  INVALID
}

enum BraceletDeliveryStatus {
  ORDERED
  SHIPPED
  DELIVERED
}

enum UserPlan {
  none
  basic
  premium
}

enum UserStatus {
  active
  blocked
  deactivated
  deleted
}

enum UserProfileType {
  person
  company
}

enum StaffRole {
  admin
  manager
}

enum BadgeType {
  government
  unqx_staff
}

enum SlugStatus {
  free
  pending
  approved
  active
  paused
  private
  blocked
  reserved_drop
}

enum ReferralStatus {
  registered
  paid
  rewarded
}

enum ReferralRewardType {
  discount
  free_month
  bonus_slug
}

enum FlashSaleConditionType {
  all
  pattern_000
  pattern_aaa
  sequential_digits
  custom
}

enum SettingValueType {
  number
  text
  boolean
  json
  textarea
  color
}

enum DropSlugPatternType {
  random
  sequential
  themed
  manual
}

enum SlugRequestStatus {
  new
  contacted
  paid
  approved
  rejected
  expired
}

enum OrderKind {
  slug_purchase
  subscription_renewal
}

enum PurchaseType {
  slug
  basic_plan
  premium_plan
  upgrade_to_premium
  premium_subscription_monthly
  bracelet
}

enum BonusLedgerDirection {
  credit
  debit
}

enum BonusLedgerKind {
  referral_reward
  bonus_spend
  bonus_refund
  manual_adjustment
}

enum ReferralConversionStatus {
  pending
  approved
  reversed
}

enum ReferralCampaignType {
  source_offer
  promo_code
}

enum ReferralCampaignStatus {
  draft
  active
  paused
  archived
}

enum PromoCodeStatus {
  draft
  active
  paused
  archived
}

enum PromoCodeDiscountType {
  discount_amount
  fixed_price
  discount_percent
}

enum ReferralFraudVerdict {
  allow
  block
  review
}

model ErrorLog {
  id         String   @id @default(uuid())
  type       String   @db.VarChar(30)
  path       String
  message    String?
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@map("error_logs")
}

model BraceletOrder {
  id             String                 @id @default(uuid())
  orderId        String                 @unique @map("order_id")
  name           String                 @db.VarChar(100)
  slug           String                 @db.VarChar(20)
  deliveryStatus BraceletDeliveryStatus @default(ORDERED) @map("delivery_status")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([deliveryStatus, createdAt])
  @@map("bracelet_orders")
}

model SlugCheckerLog {
  id        String        @id @default(uuid())
  slug      String?       @db.VarChar(20)
  pattern   String        @db.VarChar(20)
  source    String        @db.VarChar(20)
  result    CheckerResult
  checkedAt DateTime      @default(now()) @map("checked_at")

  @@index([checkedAt])
  @@index([pattern, checkedAt])
  @@index([source, checkedAt])
  @@map("slug_checker_logs")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(20)
  tariff    Tariff
  text      String
  isVisible Boolean  @default(true) @map("is_visible")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isVisible, sortOrder])
  @@map("testimonials")
}

model User {
  id                     String                @id @default(uuid())
  telegramChatId         String?               @unique @map("telegram_chat_id") @db.VarChar(40)
  telegramUsername       String?               @map("telegram_username") @db.VarChar(120)
  email                  String?               @unique @db.VarChar(190)
  login                  String?               @unique @db.VarChar(190)
  pendingEmail           String?               @map("pending_email") @db.VarChar(190)
  passwordHash           String?               @map("password_hash")
  emailVerified          Boolean               @default(false) @map("email_verified")
  otpCode                String?               @map("otp_code")
  otpExpiresAt           DateTime?             @map("otp_expires_at")
  otpAttempts            Int                   @default(0) @map("otp_attempts")
  resetPasswordToken     String?               @map("reset_password_token")
  resetPasswordExpiresAt DateTime?             @map("reset_password_expires_at")
  lastLoginAt            DateTime?             @map("last_login_at")
  loginAttempts          Int                   @default(0) @map("login_attempts")
  lockedUntil            DateTime?             @map("locked_until")
  firstName              String                @map("first_name") @db.VarChar(120)
  lastName               String?               @map("last_name") @db.VarChar(120)
  city                   String?               @db.VarChar(120)
  username               String?               @db.VarChar(120)
  displayName            String?               @map("display_name") @db.VarChar(120)
  plan                   UserPlan              @default(none)
  planPurchasedAt        DateTime?             @map("plan_purchased_at")
  planUpgradedAt         DateTime?             @map("plan_upgraded_at")
  subscriptionStartedAt  DateTime?             @map("subscription_started_at")
  subscriptionExpiresAt  DateTime?             @map("subscription_expires_at")
  subscriptionRenewedAt  DateTime?             @map("subscription_renewed_at")
  welcomeDismissed       Boolean               @default(false) @map("welcome_dismissed")
  notificationsEnabled   Boolean               @default(true) @map("notifications_enabled")
  status                 UserStatus            @default(active)
  profileType            UserProfileType       @default(person) @map("profile_type")
  deactivatedAt          DateTime?             @map("deactivated_at")
  reactivationDeadlineAt DateTime?             @map("reactivation_deadline_at")
  reactivationOtpCode    String?               @map("reactivation_otp_code")
  reactivationOtpExpiresAt DateTime?           @map("reactivation_otp_expires_at")
  reactivationOtpSentAt  DateTime?             @map("reactivation_otp_sent_at")
  deletionReminder7SentAt DateTime?            @map("deletion_reminder_7_sent_at")
  deletionReminder1SentAt DateTime?            @map("deletion_reminder_1_sent_at")
  deletedAt              DateTime?             @map("deleted_at")
  isVerified             Boolean               @default(false) @map("is_verified")
  verifiedCompany        String?               @map("verified_company") @db.VarChar(160)
  verifiedAt             DateTime?             @map("verified_at")
  showInDirectory        Boolean               @default(true) @map("show_in_directory")
  directorySector        String?               @map("directory_sector") @db.VarChar(20)
  createdByStaffId       String?               @map("created_by_staff_id") @db.Uuid
  createdByStaff         StaffUser?            @relation("StaffCreatedUsers", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  refCode                String?               @unique @map("ref_code") @db.VarChar(40)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  slugs                  Slug[]
  profileCard            ProfileCard?
  slugRequests           SlugRequest[]
  slugWaitlistEntries    SlugWaitlist[]
  referralsMade          Referral[]            @relation("ReferrerReferrals")
  referralsReceived      Referral[]            @relation("ReferredReferrals")
  referralConversionsAsReferrer ReferralConversion[] @relation("ReferralConversionReferrer")
  referralConversionsAsReferred ReferralConversion[] @relation("ReferralConversionReferred")
  referralCampaignUsages ReferralCampaignUsage[]
  referralFraudChecks    ReferralFraudCheck[]
  bonusWallet            UserBonusWallet?
  bonusLedger            BonusLedger[]
  dropWaitlistEntries    DropWaitlist[]
  unqxGameSpins          UnqxGameSpin[]
  unqScore               UnqScore?
  scoreHistory           ScoreHistory[]
  purchases              Purchase[]
  verificationRequests   VerificationRequest[]
  violationReports      ViolationReport[]
  privatePasswords       CardPrivatePassword[] @relation("CardPrivatePasswords")
  privateAccessLogs      CardPrivateAccessLog[] @relation("CardPrivateAccessLogs")
  badgeApplications      BadgeApplication[]

  @@index([plan, planPurchasedAt])
  @@index([subscriptionExpiresAt])
  @@index([plan, subscriptionExpiresAt])
  @@index([status])
  @@index([status, reactivationDeadlineAt])
  @@map("users")
}

model StaffUser {
  id          String    @id @default(uuid())
  login       String    @unique @db.VarChar(190)
  passwordHash String   @map("password_hash")
  role        StaffRole @default(manager)
  isActive    Boolean   @default(true) @map("is_active")
  name        String?   @db.VarChar(120)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdUsers User[]   @relation("StaffCreatedUsers")

  @@map("staff_users")
}

model Slug {
  id                 String      @id @default(uuid())
  letters            String      @db.VarChar(3)
  digits             String      @db.VarChar(3)
  fullSlug           String      @unique @map("full_slug") @db.VarChar(20)
  ownerId            String?     @map("owner_id")
  owner              User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status             SlugStatus  @default(free)
  isPrimary          Boolean     @default(false) @map("is_primary")
  price              Int?
  pauseMessage       String?     @map("pause_message") @db.VarChar(220)
  requestedAt        DateTime?   @map("requested_at")
  pendingExpiresAt   DateTime?   @map("pending_expires_at")
  analyticsViewsCount Int        @default(0) @map("analytics_views_count")
  approvedAt         DateTime?   @map("approved_at")
  activatedAt        DateTime?   @map("activated_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([ownerId, status])
  @@index([status, updatedAt])
  @@index([analyticsViewsCount(sort: Desc)])
  @@map("slugs")
}

model SlugWaitlist {
  id        String   @id @default(uuid())
  fullSlug  String   @map("full_slug") @db.VarChar(20)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([fullSlug, createdAt])
  @@index([userId, createdAt])
  @@map("slug_waitlist")
}

model ProfileCard {
  id           String    @id @default(uuid())
  ownerId      String    @unique @map("owner_id")
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(120)
  role         String?   @db.VarChar(120)
  bio          String?   @db.VarChar(120)
  hashtag      String?   @db.VarChar(50)
  address      String?
  postcode     String?   @db.VarChar(20)
  email        String?   @db.VarChar(100)
  extraPhone   String?   @map("extra_phone") @db.VarChar(30)
  avatarUrl    String?   @map("avatar_url")
  tags         Json      @default("[]")
  buttons      Json      @default("[]")
  theme        CardTheme @default(default_dark)
  customColor  String?   @map("custom_color") @db.VarChar(20)
  showBranding Boolean   @default(true) @map("show_branding")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("profile_cards")
}

model CardPrivatePassword {
  id           String               @id @default(uuid())
  ownerId      String               @map("owner_id")
  owner        User                 @relation("CardPrivatePasswords", fields: [ownerId], references: [id], onDelete: Cascade)
  label        String?              @db.VarChar(80)
  passwordHash String               @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  lastUsedAt   DateTime?            @map("last_used_at")
  deletedAt    DateTime?            @map("deleted_at")
  accessLogs   CardPrivateAccessLog[] @relation("CardPrivatePasswordLogs")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, deletedAt])
  @@map("card_private_passwords")
}

model CardPrivateAccessLog {
  id           String              @id @default(uuid())
  ownerId      String              @map("owner_id")
  owner        User                @relation("CardPrivateAccessLogs", fields: [ownerId], references: [id], onDelete: Cascade)
  slug         String              @db.VarChar(20)
  passwordId   String?             @map("password_id")
  password     CardPrivatePassword? @relation("CardPrivatePasswordLogs", fields: [passwordId], references: [id], onDelete: SetNull)
  passwordLabel String?            @map("password_label") @db.VarChar(80)
  viewerDevice String?             @map("viewer_device") @db.VarChar(220)
  viewerIpHash String?             @map("viewer_ip_hash") @db.VarChar(64)
  userAgent    String?             @map("user_agent")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([slug, createdAt(sort: Desc)])
  @@map("card_private_access_logs")
}

model SlugRequest {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String            @db.VarChar(20)
  slugPrice          Int               @map("slug_price")
  requestedPlan      UserPlan          @map("requested_plan")
  orderKind          OrderKind         @default(slug_purchase) @map("order_kind")
  subscriptionMonths Int               @default(0) @map("subscription_months")
  planPrice          Int               @default(0) @map("plan_price")
  bracelet           Boolean           @default(false)
  status             SlugRequestStatus @default(new)
  adminNote          String?           @map("admin_note")
  dropId             String?           @map("drop_id")
  drop               Drop?             @relation(fields: [dropId], references: [id], onDelete: SetNull)
  flashSaleId        String?           @map("flash_sale_id")
  flashSale          FlashSale?        @relation(fields: [flashSaleId], references: [id], onDelete: SetNull)
  flashDiscountAmount Int              @default(0) @map("flash_discount_amount")
  refCode            String?           @map("ref_code") @db.VarChar(40)
  refSource          String?           @map("ref_source") @db.VarChar(40)
  refOffer           String?           @map("ref_offer") @db.VarChar(80)
  campaignId         String?           @map("campaign_id")
  campaign           ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  promoCode          String?           @map("promo_code") @db.VarChar(32)
  fraudVerdict       ReferralFraudVerdict? @map("fraud_verdict")
  fraudReason        String?           @map("fraud_reason")
  campaignSnapshot   Json?             @map("campaign_snapshot")
  inviteeDiscountApplied Int           @default(0) @map("invitee_discount_applied")
  promoDiscountApplied Int             @default(0) @map("promo_discount_applied")
  bonusSpent         Int               @default(0) @map("bonus_spent")
  discountCapApplied Int               @default(0) @map("discount_cap_applied")
  conversion         ReferralConversion?
  bonusLedger        BonusLedger[]
  campaignUsage      ReferralCampaignUsage[]
  fraudChecks        ReferralFraudCheck[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderKind, createdAt])
  @@index([slug])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([fraudVerdict, createdAt(sort: Desc)])
  @@index([promoCode])
  @@map("slug_requests")
}

model Purchase {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PurchaseType
  amount          Int
  slug            String?      @db.VarChar(20)
  purchasedAt     DateTime     @default(now()) @map("purchased_at")
  approvedByAdmin String?      @map("approved_by_admin") @db.VarChar(40)
  approvedAt      DateTime?    @map("approved_at")
  subscriptionPeriodStart DateTime? @map("subscription_period_start")
  subscriptionPeriodEnd   DateTime? @map("subscription_period_end")
  note            String?
  refCode         String?      @map("ref_code") @db.VarChar(40)
  refSource       String?      @map("ref_source") @db.VarChar(40)
  refOffer        String?      @map("ref_offer") @db.VarChar(80)
  campaignId      String?      @map("campaign_id")
  campaign        ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  promoCode       String?      @map("promo_code") @db.VarChar(32)
  fraudVerdict    ReferralFraudVerdict? @map("fraud_verdict")
  fraudReason     String?      @map("fraud_reason")
  campaignSnapshot Json?       @map("campaign_snapshot")
  inviteeDiscountApplied Int   @default(0) @map("invitee_discount_applied")
  promoDiscountApplied Int     @default(0) @map("promo_discount_applied")
  bonusSpent      Int          @default(0) @map("bonus_spent")
  discountCapApplied Int       @default(0) @map("discount_cap_applied")
  conversion      ReferralConversion?
  bonusLedger     BonusLedger[]
  campaignUsage   ReferralCampaignUsage[]

  @@index([userId, purchasedAt(sort: Desc)])
  @@index([type, purchasedAt(sort: Desc)])
  @@index([slug])
  @@index([campaignId, purchasedAt(sort: Desc)])
  @@index([fraudVerdict, purchasedAt(sort: Desc)])
  @@index([promoCode])
  @@map("purchases")
}

model UserBonusWallet {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_bonus_wallet")
}

model BonusLedger {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction     BonusLedgerDirection
  kind          BonusLedgerKind
  amount        Int
  balanceAfter  Int                 @map("balance_after")
  idempotencyKey String             @unique @map("idempotency_key") @db.VarChar(120)
  orderId       String?             @map("order_id")
  order         SlugRequest?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId    String?             @map("purchase_id")
  purchase      Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  conversionId  String?             @map("conversion_id")
  conversion    ReferralConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([purchaseId])
  @@index([conversionId])
  @@map("bonus_ledger")
}

model ReferralConversion {
  id                    String                   @id @default(uuid())
  referrerId            String                   @map("referrer_id")
  referrer              User                     @relation("ReferralConversionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId            String                   @map("referred_id")
  referred              User                     @relation("ReferralConversionReferred", fields: [referredId], references: [id], onDelete: Cascade)
  refCode               String?                  @map("ref_code") @db.VarChar(40)
  refSource             String?                  @map("ref_source") @db.VarChar(40)
  refOffer              String?                  @map("ref_offer") @db.VarChar(80)
  status                ReferralConversionStatus @default(pending)
  rewardAmount          Int                      @default(0) @map("reward_amount")
  inviteeDiscountApplied Int                     @default(0) @map("invitee_discount_applied")
  bonusSpent            Int                      @default(0) @map("bonus_spent")
  orderId               String?                  @unique @map("order_id")
  order                 SlugRequest?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId            String?                  @unique @map("purchase_id")
  purchase              Purchase?                @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?                @map("approved_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  bonusLedger           BonusLedger[]

  @@index([referrerId, createdAt(sort: Desc)])
  @@index([referredId, createdAt(sort: Desc)])
  @@index([refSource, refOffer, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("referral_conversions")
}

model ReferralCampaign {
  id                         String                 @id @default(uuid())
  name                       String                 @db.VarChar(180)
  type                       ReferralCampaignType
  status                     ReferralCampaignStatus @default(draft)
  source                     String?                @db.VarChar(40)
  offer                      String?                @db.VarChar(80)
  promoCode                  String?                @map("promo_code") @db.VarChar(32)
  rewardAmountOverride       Int?                   @map("reward_amount_override")
  inviteeDiscountOverride    Int?                   @map("invitee_discount_override")
  discountCapPercentOverride Float?                 @map("discount_cap_percent_override")
  priority                   Int                    @default(0)
  budgetAmount               Int                    @default(0) @map("budget_amount")
  perUserCap                 Int                    @default(1) @map("per_user_cap")
  startsAt                   DateTime?              @map("starts_at")
  endsAt                     DateTime?              @map("ends_at")
  createdBy                  String?                @map("created_by") @db.VarChar(80)
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  orders                     SlugRequest[]
  purchases                  Purchase[]
  usages                     ReferralCampaignUsage[]

  @@index([status, type, startsAt, endsAt])
  @@index([source, offer, status, priority(sort: Desc)])
  @@index([promoCode, status, priority(sort: Desc)])
  @@map("referral_campaigns")
}

model PromoCode {
  id           String                @id @default(uuid())
  code         String                @unique @db.VarChar(32)
  name         String                @db.VarChar(180)
  status       PromoCodeStatus       @default(draft)
  discountType PromoCodeDiscountType @map("discount_type")
  discountValue Int                  @map("discount_value")
  budgetAmount Int                   @default(0) @map("budget_amount")
  perUserCap   Int                   @default(1) @map("per_user_cap")
  startsAt     DateTime?             @map("starts_at")
  endsAt       DateTime?             @map("ends_at")
  createdBy    String?               @map("created_by") @db.VarChar(80)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([status, startsAt, endsAt])
  @@index([code, status, discountType])
  @@map("promo_codes")
}

model ReferralCampaignUsage {
  id             String          @id @default(uuid())
  campaignId     String          @map("campaign_id")
  campaign       ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?         @map("order_id")
  order          SlugRequest?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId     String?         @map("purchase_id")
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status         String          @default("reserved") @db.VarChar(20)
  amountSpent    Int             @default(0) @map("amount_spent")
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(120)
  createdAt      DateTime        @default(now()) @map("created_at")
  finalizedAt    DateTime?       @map("finalized_at")
